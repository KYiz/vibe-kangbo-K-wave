Xb7tXUf6/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "@雁菁💞", "isV": 0, "vDesc": "文字中谋心，阅读中谋趣，烟火中谋生。", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "人丑就要多读书，腹有诗书气自华。", "medalInfo": {"id": "M2-0-500", "desc": "阅读时长", "title": "阅读时长", "levelIndex": 500}}}}]}, {"range": "6600-6619", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 7, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "339656082_8buOle4Oz", "review": {"abstract": "升值时间5～7年，贬值时间大约为10年。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "10 美元破百的全球影响", "chapterUid": 15, "content": "回头再看", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "onlyVisibleOneBook": 1, "range": "6600-6620", "createTime": 1787208732, "title": "", "type": 1, "chapterIdx": 15, "reviewId": "339656082_8buOle4Oz", "userVid": 339656082, "topics": [], "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "10 美元破百的全球影响", "author": {"userVid": 339656082, "name": "Holiday", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTKdDbru8q7iaic1UulpdgHxe1kGD829XHUteJUvzHSJibSuAKoSK8jQcicjGJicr6Mum4tAdbbaQ9J0CYA/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M12-0-0-E-0-0-0", "desc": "世界读书日", "title": "世界读书日", "levelIndex": 0}}}}, {"reviewId": "254854030_880PynHTc", "review": {"type": 1, "bookId": "3300128305", "chapterUid": 15, "content": "美元升值通常是因为美国经济率先复苏、增速明显强于其他国家、美联储加息收紧货币、全球资金避险回流美国，这种情况往往发生在全球危机后或美国独强阶段。资金涌入速度快力度猛，所以美元上涨快时间集中，一般5-7年就把涨幅走完并不会拖很久。\n而美元贬值是因为美国长期存在贸易逆差、财政赤字、美元过度外流，加上其他国家经济逐步追赶、欧洲或新兴市场崛起、美联储降息宽松、全球风险偏好上升，资金从美国流向全世界。这个过程是缓慢、渐进、长期扩散的，不会像升值那样剧烈，所以贬值周期天然更长，通常要10年左右才能完成一轮充分走弱。再加上美元作为全球核心货币，承担着向全世界提供流动性的角色，长期必然是中期走强、长期走弱的结构，最终就形成升值快而短，贬值慢而长的规律。", "bookVersion": 1748903449, "abstract": "美元指数呈现一定的周期特征，1980—1985年升值，1985—1995年贬值，1995—2002年升值，2002—2011年贬值。升值时间5～7年，贬值时间大约为10年。", "range": "6534-6620", "chapterName": "10 美元破百的全球影响", "chapterIdx": 15, "reviewId": "254854030_880PynHTc", "userVid": 254854030, "topics": [], "createTime": 1774940993, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "10 美元破百的全球影响", "author": {"userVid": 254854030, "name": "薄荷白桃乌龙茶", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/DYAIOgq83eotCrwSFSicibG99Nkf5vrg0ff5gIBNXvxUEHLjQOgqCkgge06Nib9Vp2791QZZJPKUpm1JVpXRn1RoA/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M13-20240826-10", "desc": "每周阅读挑战", "title": "完美阅读周", "levelIndex": 10}}}, "likesCount": 6}, {"reviewId": "86994695_86GX91M8G", "review": {"bookId": "3300128305", "content": "上一次升值时间为2016－2018，贬值周期为2026或2028，也就是说最晚2028年美元重启升值周期🤔并一直到2032年或2035年", "bookVersion": 1748903449, "range": "6600-6619", "abstract": "升值时间5～7年，贬值时间大约为10年", "type": 1, "onlyVisibleOneBook": 1, "chapterUid": 15, "chapterName": "10 美元破百的全球影响", "chapterIdx": 15, "reviewId": "86994695_86GX91M8G", "userVid": 86994695, "topics": [], "createTime": 1770290328, "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub