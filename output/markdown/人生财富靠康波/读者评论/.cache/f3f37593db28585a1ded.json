ackBy": 0, "isHide": 0, "nick": "利行萍踪", "isV": 0, "vDesc": "在阅读中寻求力量", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M13-20250331-25", "desc": "每周阅读挑战", "title": "狂暴阅读周", "levelIndex": 25}}, "replyUser": {"userVid": 906440371, "name": "花開富貴", "avatar": "https://wx.qlogo.cn/mmhead/8tJsYh1ic3jicUxJNBFMbrypiadOGxE9ibFsPUzStEUkaoE7bvP0FaoglNDWP8qYPbDkQk6PD7uCBc4/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": ""}}, {"reviewId": "917607060_88KrsCA4i", "content": "    我是最近才看了日本泡沫经济后的三十年的一些资料，产能过剩——内卷加剧——学历贬值——企业出海，同时叠加老龄化，财政不足造成老年人照护也不利。少子化带来教育系统大改革，教师地位一落千丈等等。\n    特别喜欢叶真中显的小说，都是描写这三十年的儿童犯罪、妇女犯罪、金融犯罪。\n    也许历史是最好的老师，如果一遍学不会，它会再教一遍。\n    ", "toUserVid": 906440371, "toCommentId": "917607060_88KrsCA4i_c906440371_8943ddTKv", "commentId": "917607060_88KrsCA4i_c917607060_89477bt1i", "userVid": 917607060, "createTime": 1778649096, "likesCount": 2, "isLike": 0, "author": {"userVid": 917607060, "name": "利行萍踪", "avatar": "https://wx.qlogo.cn/mmhead/dx4Y70y9XctpHZ9ySrIYe6X3aOakMpcNQz5yFmQGqcYwQb3pz7m9FFfYUG0b5KybQ9VHicyvjL2k/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "利行萍踪", "isV": 0, "vDesc": "在阅读中寻求力量", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M13-20250331-25", "desc": "每周阅读挑战", "title": "狂暴阅读周", "levelIndex": 25}}, "replyUser": {"userVid": 906440371, "name": "花開富貴", "avatar": "https://wx.qlogo.cn/mmhead/8tJsYh1ic3jicUxJNBFMbrypiadOGxE9ibFsPUzStEUkaoE7bvP0FaoglNDWP8qYPbDkQk6PD7uCBc4/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": ""}}, {"content": "任何东西、泡沫都会到顶，难的是逃顶", "reviewId": "917607060_88KrsCA4i", "toCommentId": "917607060_88KrsCA4