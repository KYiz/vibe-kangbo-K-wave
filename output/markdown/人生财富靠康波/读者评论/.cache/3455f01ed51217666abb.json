atus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "06 结构主义的薪火 周期波动、结构演进与制度变革", "author": {"userVid": 224769020, "name": "自由，死亡与审判", "avatar": "https://res.weread.qq.com/wravatar/WV0025-Uq7IKZpqBGFQrqPLhABF1f5/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "自由，死亡与审判", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "九万里风鹏正举，五百年人间逍遥。", "medalInfo": {"id": "M5-0-100", "desc": "读完书籍", "title": "读完书籍", "levelIndex": 100}}}, "likesCount": 14}, {"reviewId": "427438648_8aCBaU8VU", "review": {"bookId": "3300128305", "content": "就是此时", "bookVersion": 1748903449, "range": "2967-3049", "abstract": "因为进入走向成熟阶段后，增长问题的重要性降低，而全社会由于劳动力等生产要素的变化，开始进入一个更加关注财富分配的阶段，这是工业化自身的宿命，是起飞期财富集中的结果。", "type": 1, "chapterUid": 11, "chapterName": "06 结构主义的薪火 周期波动、结构演进与制度变革", "chapterIdx": 11, "reviewId": "427438648_8aCBaU8VU", "userVid": 427438648, "topics": [], "createTime": 1784129457, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "06 结构主义的薪火 周期波动、结构演进与制度变革", "author": {"userVid": 427438648, "name": "Chris", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/snpDqibgbTIIH74ygACwkRFAMIaISb3ib5WjhJ8rX3icLicKhiahXn9hNBQicLUnob1tHh1sn4nGm67FcFKzPxPQFj2FdSElkJ72xcCUowrGZbHuE/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "Chris", "isV": 0, "vDesc": "执业律师，刑事辩护，民商事诉讼", "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "13634154840", "medalInfo": {"id": "M13-20250127-25", "desc": "每周阅读挑战", "title": "狂暴阅读周", "levelIndex": 25}}}, "likesCount": 1}, {"reviewId": "32395076_89G2pW9By", "review": {"abstract": "进入走向成熟阶段后，增长问题的重要性降低，而全社会由于劳动力等生产要素的变化，开始进入一个更加关注财富分配的阶段，这是工业化自身的宿命，是起飞期财富集中的结果", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "06 结构主义的薪火 周期波动、结构演进与制度变革", "chapterUid": 11, "content": "即使是在工业化的成熟阶段，增长的重要，性也没有降低。这是由于损失厌恶、禀赋效应、期望效应等一系列人类行为经济学角度的心理因素导致的。在经历了高速增长之后，“不增长或增长慢了”，都会带来“损失厌恶”，这种不良情绪的后果并不比贫富两极分化的危害小，因为这会影响最关键的“消费信心”，导致被动储蓄、预防性储蓄，甚至通缩!所以，即便是在最发达的美国，对经济增速的考虑也是放在首位的，无论是美国总统（直接影响他的票仓），还是美联储都不敢怠慢的。所以说，我认为只能说是：工业化的成熟阶段比之前对财富分配的关注有所增加，但是的从关注总结构来看，依然是更关注增长。“增长”是政府和人民关注的永恒主题。", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "onlyVisibleOneBook": 1, "range": "2969-3048", "createTime": 1780803201, "title": "", "type": 1, "chapterIdx": 11, "reviewId": "32395076_89G2pW9By", "userVid": 32395076, "topics": [], "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "06 结构主义的薪火 周期波动、结构演进与制度变革", "author": {"userVid": 32395076, "name": "云瑞", "avatar": "https://wx.qlogo.cn/mmhead/5K48YNcpF3Z9lDTr5gGgloINxh2viaK0Vjwh2zu9UdtWS4KYFNVaVBSChos7s7gB5sDFFfxxodJY/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "vDesc": "盐米酱醋茶，文史哲政经。", "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "既要思索，又要烟火；形而上下，无问西东。", "medalInfo": {"id": "M8-202306-40", "desc": "每月阅读挑战", "title": "完美阅读月", "levelIndex": 40}}}, "likesCount": 2}, {"reviewId": "217328893_85Y5EG7wi", "review": {"abstract": "因为进入走向成熟阶段后，增长问题的重要性降低，而全社会由于劳动力等生产要素的变化，开始进入一