{"vid": 340791361, "bookId": "3300128305", "chapterUid": 12, "reviews": [{"range": "355-357", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "9583959_8cY1Leuee", "review": {"bookId": "3300128305", "content": "个人总结：\n整本书是周金涛的研报，关于康波周期理论研究，从发布康波周期理论开始，历史来看目前经历了4 5次，整本书都是其个人的宏观判断。\n周期套周期，大周期，中周期，小周期。\n1康波周期约等于3个地产周期，约等于9个朱格拉，18个库存周期。\n阅读顺序：\n先读7工具，再度1结论，最后看9应用。再按照资产主题读10到14，第三部分最后读。\n先定为自己处于康波周期的哪个阶段，再看国家想出什么主导产业，最后看拿什么资产。\n没有什么东西是一成不变的。", "bookVersion": 1748903449, "range": "355-357", "abstract": "07", "type": 1, "onlyVisibleOneBook": 1, "chapterUid": 12, "chapterName": "07 三周期嵌套 从熊彼特到罗斯托", "chapterIdx": 12, "reviewId": "9583959_8cY1Leuee", "userVid": 9583959, "topics": [], "createTime": 1792389848, "contextAbstract": "07 三周期嵌套　从", "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "07 三周期嵌套 从熊彼特到罗斯托", "author": {"userVid": 9583959, "name": "佳君jiang🍮", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/pKCcg2XlfTDlplDGiawImt1iaMmTXXeXop0vawmoNs790ATS3ZIz36QMQ3h0nnib9kYrHkttmB0nictc0iaTlmiaxxDBbic7RkYzqWenooNvTfFtDU/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M4-0-100", "desc": "阅读书籍", "title": "阅读书籍", "levelIndex": 100}}}}]}, {"range": "600-619", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 2, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "447537194_8aBcSVR53", "review": {"abstract": "新古典学派乘数-加速数作用下的经济周期", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "07 三周期嵌套 