xIdx": 0, "totalCount": 2, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "237554720_89VkCbpGo", "review": {"type": 1, "bookId": "3300128305", "chapterUid": 11, "content": "2-4个季度就是6-12个月 也就是2012年中-年末市场才开始反应", "bookVersion": 1748903449, "abstract": "但在2011年前能见到这个系统性逻辑实现的可能性不大。也就是说，市场的反转趋势基础仍然欠缺。按经济周期的惯常经验，在库存周期回落后，经历2～4个季度的混沌模糊期是正常的，对这一点我们要有充分的准备。", "range": "33976-34075", "chapterName": "06 结构主义的薪火 周期波动、结构演进与制度变革", "chapterIdx": 11, "reviewId": "237554720_89VkCbpGo", "userVid": 237554720, "topics": [], "createTime": 1781671876, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "06 结构主义的薪火 周期波动、结构演进与制度变革", "author": {"userVid": 237554720, "name": "Flaaaaaaaaash", "avatar": "https://res.weread.qq.com/wravatar/WV0022-NhbHkFzMelK60ty1tUcTH10/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "vDesc": "So it goes", "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "永远真实 保持热爱", "medalInfo": {"id": "M7-0-1000", "desc": "想法发布", "title": "想法发布", "levelIndex": 1000}}}, "likesCount": 2}, {"reviewId": "426066534_89hy0H1QB", "review": {"abstract": "库存周期回落后，经历2～4个季度的混沌模糊期是正常的，", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "06 结构主义的薪火 周期波动、结构演进与制度变革", "chapterUid": 11, "content": "但有一般规律性，半年到1年的低位震荡", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "34034-34061", "createTime": 1779412139, "title": "", "type": 1, "chapterIdx": 11, "reviewId": "426066534_89hy0H1QB", "userVid": 426066534, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "06 结构主义的薪火 周期波动、结构演进与制度变革", "author": {"userVid": 426066534, "name": "阳.", "avatar": "https://res.weread.qq.com/wravatar/WV0001-o8W1y4kRnfhpyNG0a2oPXe1/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "vDesc": "纯与真，丙丁炼庚金", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "愿祖国繁荣昌盛，国泰民安。", "medalInfo": {"id": "M14-0-100", "desc": "拯救书荒", "title": "好书导读人", "levelIndex": 100}}}, "likesCount": 1}]}, {"range": "34275-34316", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "426066534_8d2X2tIyC", "review": {"abstract": "对资本市场而言，在2012年之前，研究清楚在转型背景下的中周期景气才是问题的核心。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "06 结构主义的薪火 周期波动、结构演进与制度变革", "chapterUid": 11, "content": "结构性转型是一个指明方向，定性的东西，中周期景气是当下，眼前现实哪些行业会由价格降低一定程度后，企业主重建库存，带动一轮设备资本支出的中周期繁荣。这些行业可能会是长期结构性转型产业的雏形", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "34275-34316", "createTime": 1792669523, "title": "", "type": 1, "chapterIdx": 11, "reviewId": "426066534_8d2X2tIyC", "userVid": 426066534, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "06 结构主义的薪火 周期波动、结构演进与制度变革", "author": {"userVid": 426066534, "name": "阳.", "avatar": "https://res.weread.qq.com/