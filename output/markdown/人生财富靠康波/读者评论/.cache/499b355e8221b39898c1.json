 "6633-6635", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "279966354_7ZSj5uiEp", "review": {"abstract": "滞胀", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "chapterUid": 8, "content": "滞胀期经济增长开始下滑，但通胀却继续上升，企业为了保持盈利提高产品价格，导致价格螺旋上涨，企业的盈利恶化。", "contextAbstract": "上涨导致了世界经济的滞胀，反过来考虑，滞胀本", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "6633-6635", "createTime": 1746283931, "title": "", "type": 1, "reviewId": "279966354_7ZSj5uiEp", "userVid": 279966354, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterIdx": 8, "chapterTitle": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "author": {"userVid": 279966354, "name": "NAMI-歪", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/DYAIOgq83epm52h3dJuDvNO6WB3zUw9qQ2NrSr7f9WzZYAbwjsZgkCAXuC9j5iaXQ3mvbVUJhUcOLuEoGrfroyw/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "vDesc": "探索、透视客观世界规律", "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "提升意识能量，自在喜乐", "medalInfo": {"id": "M2-0-1000", "desc": "阅读时长", "title": "阅读时长", "levelIndex": 1000}}}, "likesCount": 7}]}, {"range": "6689-6710", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "10259823_8d1utgk7U", "review": {"abstract": "当时世界各国的经济特征仍然带有很大的封闭性", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "chapterUid": 8, "content": "70年代全球不算高度全球化。\n每个国家产业比较全，很多东西自己造、自己卖，自给自足，产业链没有拆到全世界不同国家。纵向分工弱，不是现在这种：A国挖矿、B国做零件、C国组装的模式。\n所以作者把这个叫传统封闭环境。研究70年代这套规律，是拿来当参照物，方便对比我们当下全球化时代资源涨价会怎么走。", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "onlyVisibleOneBook": 1, "range": "6689-6710", "createTime": 1792586551, "title": "", "type": 1, "chapterIdx": 8, "reviewId": "10259823_8d1utgk7U", "userVid": 10259823, "topics": [], "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "author": {"userVid": 10259823, "name": "珍珠鹿", "avatar": "https://res.weread.qq.com/wravatar/WV0017-1brP1Fna5HircHAa928dz10/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "nick": "珍珠鹿", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M7-0-10", "desc": "想法发布", "title": "想法发布", "levelIndex": 10}}}, "likesCount": 1}]}, {"range": "6733-6747", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "313055314_85MsMq1a5", "review": {"type": 1, "bookId": "3300128305", "chapterUid": 8, "content": "2025年的今天，美国关税大棒高举，也没有办法按照所谓的比较优势进行国际分工了，小院高墙和脱钩成了主流意识形态", "bookVersion": 0, "abstract": "按照国际比较优势进行明确分工", "range": "6733-6747", "chapterName": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "chapterIdx": 8, "reviewId": "313055314_85MsMq1a5", "userVid": 313055314, "topics": [], "createTime": 1767081696, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "author": {"userVid": 313055314, "name": "judy", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTKjJGicacibsQQ1bODjRicqWp2obv6O9Ba6BtV5Kf4ybqoicekyHBIpZa0Yg6Fd2xEoj1fUAkVASYI8kA/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M3-0-365", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 365}}}, "likesCount": 6}]}, {"range": "6807-6809", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "35720330_83DdcE7rD", "review": {"bookId": "3300128305", "content": "当前逆全球化进入深水区，纵向一体化倒退发展，几大经济体之间关税政策导致世界经济处于割离半封闭状态，探讨开放程度低的经济环境下商品波动特点意义重大", "bookVersion": 1748903449, "range": "6807-6809", "abstract": "程度", "type": 1, "chapterUid": 8, "chapterName": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "chapterIdx": 8, "reviewId": "35720330_83DdcE7rD", "userVid": 35720330, "topics": [], "createTime": 1759512994, "contextAbstract": "界分工上的纵向一体化程度远不如现在发达。", "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "author": {"userVid": 35720330, "name": "小吉祥睡神", "avatar": "https://wx.qlogo.cn/mmhead/dx4Y70y9Xcum3UU76jYibFlCYHqGWCkica7DLMdgjFhgjBrrxIsuhob3lqgp9O8fIsM576j0SRMXM/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M9-0-10", "desc": "阅读神作", "title": "神作爱好者", "levelIndex": 10}}}, "likesCount": 2}]}, {"range": "6917-6934", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 2, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "10259823_8d1uFcFWR", "review": {"abstract": "滞胀：资源品价格上涨的传统表现形式", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "chapterUid": 8, "content": "经济学里，原材料本质就是企业的成本。原材料涨价，两条路传导：\n \n1. 企业把涨价转嫁出去 → 物价普涨（通胀）；东西变贵之后老百姓买不起，消费下降，需求慢慢萎缩。\n​\n2. 矿、能源这些资源行业看到涨价赚钱了，愿意砸钱去开矿、扩产能 → 后面供给慢慢变多。\n \n最后结果：供给上来、需求下去，供需重新平衡，资源价格跌回去。\n而这个过程里，物价涨、经济又走不动（需求弱），就是滞胀。", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "onlyVisibleOneBook": 1, "range": "6917-6934", "createTime": 1792586727, "title": "", "type": 1, "chapterIdx": 8, "reviewId": "10259823_8d1uFcFWR", "userVid": 10259823, "topics": [], "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "author": {"userVid": 10259823, "name": "珍珠鹿", "avatar": "https://res.weread.qq.com/wravatar/WV0017-1brP1Fna5HircHAa928dz10/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "nick": "珍珠鹿", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M7-0-10", "desc": "想法发布", "title": "想法发布", "levelIndex": 10}}}}, {"reviewId": "10835732_87s13KSZ3", "review": {"bookId": "3300128305", "content": "回到价格完美趋势", "bookVersion": 1748903449, "range": "6917-6934", "abstract": "滞胀：资源品价格上涨的传统表现形式", "type": 1, "onlyVisibleOneBook": 1, "chapterUid": 8, "chapte