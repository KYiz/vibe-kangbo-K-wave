alCount": 2, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "447537194_8avH3Nc6f", "review": {"abstract": "供需缺口的逐步弥合及全球流动性的逐步收缩", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "chapterUid": 8, "content": "因素", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "onlyVisibleOneBook": 1, "range": "6418-6438", "createTime": 1783737247, "title": "", "type": 1, "chapterIdx": 8, "reviewId": "447537194_8avH3Nc6f", "userVid": 447537194, "topics": [], "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "author": {"userVid": 447537194, "name": "冰果果🍧🍨", "avatar": "https://wx.qlogo.cn/mmhead/OO4hxIIN2cV9OInRdyjDMxl2eJWCJ2xhTZcdHBAIiaOJBBTbtVMVJlyUqyuDricsFso9vXTSvRofk/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M3-0-100", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 100}}}}, {"reviewId": "426066534_8czVDvlQy", "review": {"abstract": "但伴随着经济增长中周期的回落、供需缺口的逐步弥合及全球流动性的逐步收缩，商品价格牛市的根基将不断受到侵蚀，", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "chapterUid": 8, "content": "大宗商品牛市走弱的原因", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "6403-6456", "createTime": 1791021031, "title": "", "type": 1, "chapterIdx": 8, "reviewId": "426066534_8czVDvlQy", "userVid": 426066534, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "author": {"userVid": 426066534, "name": "阳.", "avatar": "https://res.weread.qq.com/wravatar/WV0001-o8W1y4kRnfhpyNG0a2oPXe1/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "vDesc": "纯与真，丙丁炼庚金", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "愿祖国繁荣昌盛，国泰民安。", "medalInfo": {"id": "M14-0-100", "desc": "拯救书荒", "title": "好书导读人", "levelIndex": 100}}}}]}, {"range": "6564-6579", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 2, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "253631353_8a1Dsapum", "review": {"bookId": "3300128305", "content": "滞胀是怎么发生？\n第一步：资源品（石油、粮食、矿石）价格暴涨\n比如1970年代，石油输出国组织（OPEC）对西方禁运，油价在几个月内翻了4倍。\n这是外部供给冲击，不是需求太旺盛导致的涨价。\n第二步：生产成本全面推高，企业扛不住\n石油是工业的血液。油价涨了：\n运输成本涨 → 所有商品运费变贵。\n化工原料涨 → 塑料、化肥、化纤都涨。\n电力成本涨 → 工厂电费飙升。\n企业生产成本暴涨，但不敢随便涨价（因为老百姓收入没涨，涨价就没人买）。\n结果：企业利润被严重挤压，开始减产、裁员、取消投资。\n→ 经济产出下降（停滞）。\n第三步：物价还在涨（通货膨胀）\n但生产成本确实高到一定程度，企业不涨价就亏本，只能硬着头皮提价。\n同时，工会要求涨工资来抵消物价上涨，工资涨了又进一步推高生产成本。\n形成“物价涨→工资涨→物价再涨”的螺旋。\n→ 物价持续上升（通胀）。\n于是：工厂在关门（停滞），但东西还在涨价（通胀）。这就是滞胀。", "bookVersion": 1748903449, "range": "6564-6579", "abstract": "滞胀：资源品价格调整的传统机制", "type": 1, "chapterUid": 8, "chapterName": "03 “色即是空” 世界经济的共生模式与国际资源品价格调节新机制", "chapterIdx": 8, "reviewId": "253631353_8a1Dsapum", "userVid": 253631353, "topics": [], "createTime": 1782029936, "userEditTime": 1782029971, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkww