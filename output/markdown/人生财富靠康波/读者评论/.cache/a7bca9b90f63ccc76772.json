{"reviewId": "64424109_7ZfqbpDjt", "review": {"abstract": "需要注意的是，如果按照繁荣、衰退、萧条、回升四个阶段来划分康波，康波的顶指的是衰退期的结束，也就是说，繁荣和衰退是康波的上升期。而康波的谷指的是回升的结束，也就是说，萧条和回升是康波的下降期。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "第一部分 涛动周期论", "chapterUid": 6, "content": "陡上升，缓上升，缓下降，缓上升", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "2025-2121", "createTime": 1744075222, "title": "", "type": 1, "reviewId": "64424109_7ZfqbpDjt", "userVid": 64424109, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterIdx": 6, "chapterTitle": "第一部分 涛动周期论", "author": {"userVid": 64424109, "name": "alcarin", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTKKg0CZ0q2CUWgqqpib5HVBgmwEGcUV9kVgFTo8B4PTibib7Wiat6YzDLnAXUFOSOfYcQ5PM8XLibNgRmQ/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "既往不咎，当下不杂，未来不迎", "medalInfo": {"id": "M3-0-500", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 500}}, "isDislike": 0}, "likesCount": 0, "likes": [], "commentsCount": 2, "hotComments": [], "comments": [{"content": "快下降，缓下降", "reviewId": "64424109_7ZfqbpDjt", "commentId": "64424109_7ZfqbpDjt_c911337923_83qNSMufK", "userVid": 911337923, "createTime": 1758808195, "author": {"userVid": 911337923, "name": "不断向前", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTLOCkhE6EF8dhex9ahQPA05c7nNCprIX2KZBFllSGDGEPxu0Aib4qtxyK9GWHmUsjia5MuwxHUDhJcw/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "不断向前", "isV": 0, "roleTags": [], 