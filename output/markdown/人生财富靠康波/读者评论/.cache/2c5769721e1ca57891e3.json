3YJgia42gDZWpgSJujHsyADgwcd65Rre6WNVEH63maBQ/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "vDesc": "一个人的判断能力受限于他的认知范围", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "不要跟蠢货讲道理！", "medalInfo": {"id": "M14-0-100", "desc": "拯救书荒", "title": "好书导读人", "levelIndex": 100}}}, "likesCount": 1}]}, {"range": "21933-21985", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 8, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "13294121_8b2dkp0c2", "review": {"abstract": "主导产业中的创新是经济增长和经济繁荣的前提，生命周期决定创新必然是非连续的，这也解释了创新下的周期波动。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "07 三周期嵌套 从熊彼特到罗斯托", "chapterUid": 12, "content": "主导产业中的创新是经济增长和繁荣的前提，回应了一些持续性的“小创新”不能带来经济繁荣的问题。生命周期决定创新必然是非连续性的，即创新存在从0→1，从1→100，从100→10000，从10000→∞（新的0起点）的生命周期，也即回应了创新的初期没有于经济的繁荣同步的问题，因为技术从萌芽到转化，再到技术扩散、成熟乃至泛化需要一个传导的时间。", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "21933-21985", "createTime": 1785584417, "title": "", "type": 1, "chapterIdx": 12, "reviewId": "13294121_8b2dkp0c2", "userVid": 13294121, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "07 三周期嵌套 从熊彼特到罗斯托", "author": {"userVid": 13294121, "name": "夏然", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/PiajxSqBRaEIeMI778aXNaPMkgDBdmvWRXYyu1E4FN1IwQuK4rVkNMcUNbQR2vUiah5cF6APuvUo1xGiaP5HLGcOg/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M3-0-200", "desc": "阅读天数