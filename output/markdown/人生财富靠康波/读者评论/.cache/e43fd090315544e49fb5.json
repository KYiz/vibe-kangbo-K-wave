Follower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "松凛月明", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M3-0-500", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 500}}}, {"reviewId": "1479351_81dGiyda7", "content": "对，下降是从萧条开始的，我觉得从2020年进入萧条应该是差不多的，现在处于回升期初期，所以经济已经在有点抬头了，虽然谷底是那样画的现在还在往谷底的方向下滑，但是我觉得现在应该是回升期了，我觉得应该是回升期和繁荣期买股票啥的各种应该是赚钱的，当他往上爬爬到一半的时候也就是繁荣期结束时衰退期来临时 就该收手了。", "toCommentId": "1479351_81dGiyda7_c217488105_85ffzKnOI", "toUserVid": 217488105, "commentId": "1479351_81dGiyda7_c926803512_89mqY3GfL", "userVid": 926803512, "createTime": 1779689688, "likesCount": 1, "isLike": 0, "author": {"userVid": 926803512, "name": "丽丽", "avatar": "https://wx.qlogo.cn/mmhead/Q3auHgzwzM4xFWo4sOEicetwy3zH3Fm39AGCvptiaDg65GqibgNAVpk4A/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M13-20251215-10", "desc": "每周阅读挑战", "title": "完美阅读周", "levelIndex": 10}}, "replyUser": {"userVid": 217488105, "name": "松凛月明", "avatar": "https://res.weread.qq.com/wravatar/WV0014-fZTQde_oPct3S0chMT0NJe8/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "松凛月明", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M3-0-500", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 500}}}, {"reviewId": "1479351_81dGiyda7", "content": "那就是他想怎么解释都行呗？没事我反正不看啦，感觉没意义", "toUserVid": 217488105, "toCommentId": "1479351_81dGiyda7_c217488105_85ffzKnOI", "commentId": "1479351_81dGiyda7_c1479351_85gQclBIg", "userVid": 1479351, "createTime": 1765285543, "author": {"userVid": 1479351, "name": "随风飘逝", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/cBHNibz5B9edkeicpHZtn8Z3vJM2moo2QVSha52qxOGNMCAnj9gO2SNSc4FX0CS86dexFtRvaDPqkiciceTmNcPQjwjLkFxjJwLBWKxUgIxRYics/132", "isFollow