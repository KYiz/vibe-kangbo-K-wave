d": "M13-20241125-10", "desc": "每周阅读挑战", "title": "完美阅读周", "levelIndex": 10}}}, "likesCount": 3}, {"reviewId": "47499302_87y4MyzNL", "review": {"bookId": "3300128305", "content": "主要是矿场勘探和开发周期较长，所谓的刚性短缺", "bookVersion": 1748903449, "range": "9525-9574", "abstract": "至于为什么完成一次循环的时间要长达50年之久，罗斯托只是提出，产品和原材料新来源的开发需要大量时间", "type": 1, "onlyVisibleOneBook": 1, "chapterUid": 12, "chapterName": "07 三周期嵌套 从熊彼特到罗斯托", "chapterIdx": 12, "reviewId": "47499302_87y4MyzNL", "userVid": 47499302, "topics": [], "createTime": 1773307737, "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "07 三周期嵌套 从熊彼特到罗斯托", "author": {"userVid": 47499302, "name": "L", "avatar": "https://wx.qlogo.cn/mmhead/Ib5852jAybicP6njMScZJ2qzmliazzYtSZsKFGeo7ibq5zR1P8ic9EmwSVcicMOma7lVZTXIsMV6mmDA/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "", "medalInfo": {"id": "M7-0-10", "desc": "想法发布", "title": "想法发布", "levelIndex": 10}}}, "likesCount": 1}, {"reviewId": "380402079_80OXVWE0X", "review": {"abstract": "至于为什么完成一次循环的时间要长达50年之久，罗斯托只是提出，产品和原材料新来源的开发需要大量时间", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "07 三周期嵌套 从熊彼特到罗斯托", "chapterUid": 12, "content": "长波的形成是和农产品是有关的，最底层是由于农产品出现了新技术，新扩张，然后形成产量增加，继而引发库存，迫使新的技术不得不解决这个农产品的问题，形成了新的技术革命。那为什么是50年？因为产品和原材料新来源的开发需要时间……这是罗斯托的解释。现在看来，农业真的是一切生产的根源，所以土地，种子，新的农业科技是基础中的重点啊，种子，尤其是农业的芯片", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "9525-9574", "createTime": 1749615765, "title": "", "type": 1, "reviewId": "380402079_80OXVWE0X", "userVid": 380402079, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterIdx": 12, "chapterTitle": "07 三周期嵌套 从熊彼特到罗斯托", "author": {"userVid": 380402079, "name": "@雁菁💞", "avatar": "https://res.weread.qq.com/wravatar/WV0013-YP88sMnDO5fc6f~Xb7tXUf6/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "@雁菁💞", "isV": 0, "vDesc": "文字中谋心，阅读中谋趣，烟火中谋生。", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "人丑就要多读书，腹有诗书气自华。", "medalInfo": {"id": "M2-0-500", "desc": "阅读时长", "title": "阅读时长", "levelIndex": 500}}}, "likesCount": 2}]}, {"range": "9627-9725", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 3, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "4456513_8cUxec2O0", "review": {"abstract": "“基本的创新引起新的工业部门的产生，新的部门需要自己的基础设施，但库存的过度积累将会发生。与此同时，在有创新投入的部门中，需求的稳定使资本的过度扩张更为明显。这两种力量结合起来促成了长波中的低迷。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "07 三周期嵌套 从熊彼特到罗斯托", "chapterUid": 12, "content": "基本创新\n基础设施投入\n需求稳定，基础设施再投入\n库存过剩，泡沫产生。\n\n长波中的下个创新未发生，新投资无处去，上轮的库存、债务问题需要处理。没有承接，长波低迷。", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "9627-9725", "createTime": 1792191475, "title": "", "type": 1, "chapterIdx": 12, "reviewId": "4456513_8cUxec2O0", "userVid": 4456513, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人