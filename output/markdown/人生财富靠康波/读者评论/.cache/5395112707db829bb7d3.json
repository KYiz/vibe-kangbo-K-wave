weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterIdx": 9, "chapterTitle": "04 长波衰退中的增长与通胀", "author": {"userVid": 380402079, "name": "@雁菁💞", "avatar": "https://res.weread.qq.com/wravatar/WV0013-YP88sMnDO5fc6f~Xb7tXUf6/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "@雁菁💞", "isV": 0, "vDesc": "文字中谋心，阅读中谋趣，烟火中谋生。", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "人丑就要多读书，腹有诗书气自华。", "medalInfo": {"id": "M2-0-500", "desc": "阅读时长", "title": "阅读时长", "levelIndex": 500}}}, "likesCount": 19, "commentsCount": 1, "hotComments": [{"content": "美国经济回落，是消费国的需求减少了，对应的制造国的出口必然减少。\n1.相应速度没有那么快。\n2.中国生产的惯性，对能源的消耗一下子降不下来。\n3.需求减少明显看到的就是价格回落，只能是贱价卖谷，多卖些才能保持原来利润，更不敢去减少生产。只有利润包不出成本的时候才会崩溃紧缩，", "reviewId": "380402079_80LZmC5lv", "commentId": "380402079_80LZmC5lv_c343563847_81xFuhYk3", "userVid": 343563847, "createTime": 1752154876, "likesCount": 7, "isLike": 0, "author": {"userVid": 343563847, "name": "左", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTIDhIpvB4hJnrIvzJgF4RJQcSOExg3WJq0AeiawLs45akb62PVAwtSGMf05vDibibkSlSfXFUEvvs5RA/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M5-0-10", "desc": "读完书籍", "title": "读完书籍", "levelIndex": 10}}}]}]}, {"range": "22194-22205", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 2, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "215171944_8bLHrvZDX", "review": {"bookId": "3300128305", "content": "指中国目前很多重要的商品的价格，不完全是由市场供需决定的，而是被政府政策，管制，补贴，垄断等因素人为压低或抬高。比如：水价，电价，气价等。“管制体系”就是政府用行政手段管理价格，土地，信贷，能源，外汇等的一套制度。它让中国能快速发展工业，控制民生成本，但也造成了效率低，隐形补贴，普通劳动者受压等问题。", "bookVersion": 1748903449, "range": "22194-22205", "abstract": "依然扭曲的价格管制体系", "type": 1, "onlyVisibleOneB