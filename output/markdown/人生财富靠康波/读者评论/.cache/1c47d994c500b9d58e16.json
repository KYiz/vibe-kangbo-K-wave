lacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "vDesc": "凡难事必有所得", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "读万卷书，行万里路，但行好事", "medalInfo": {"id": "M9-0-100", "desc": "阅读神作", "title": "神作发烧友", "levelIndex": 100}}}, "likesCount": 2}]}, {"range": "10934-11106", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 2, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "426066534_89sWrXRC2", "review": {"abstract": "另一方面由于投资者仍然存在欧元幻觉[插图]。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "10 美元破百的全球影响", "chapterUid": 15, "content": "\n1. 忽视通胀差异：投资者如果只盯着欧元对美元的汇率数字，看到欧元在涨，就觉得持有欧元资产更划算。但若欧元区的通胀率高于美国，欧元的实际购买力可能是在下降的。这种“幻觉”会导致投资者高估欧元的真实收益，反而不急于因为实际经济基本面（如利差、增长差）去推动欧元升值。\n2. 政策反应滞后：正是因为市场存在这种“看着名义汇率就觉得安全”的幻觉，欧元区央行（ECB）调整货币政策的紧迫性也会降低。当美国已经加息而欧洲还在观望时，欧元缺乏利差支撑，升值自然缓慢。\n3. 风险认知偏差：长期存在欧元幻觉，会让投资者低估欧元区内部的结构性问题（比如各国竞争力差异、债务风险）。一旦风险暴露，资金反而会流出欧元，压制汇率。", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "10934-11106", "createTime": 1780059331, "title": "", "type": 1, "chapterIdx": 15, "reviewId": "426066534_89sWrXRC2", "userVid": 426066534, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "10 美元破百的全球影响", "author": {"userVid": 426066534, "name": "阳.", "avatar": "https://res.weread.qq.com/wravatar/WV0001-o8W1y4kRnfhpyNG0a2oPXe1/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "vDesc": "纯与真，丙丁炼庚金", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "愿祖国繁荣昌盛，国泰民安。", "medalInfo": {"id": "M14-0-100", "desc": "拯救书荒", "title": "好书导读人", "levelIndex": 100}}}, "likesCount": 4}, {"reviewId": "39578508_87TiWy4zA", "review": {"bookId": "3300128305", "content": "欧元幻觉指的是，当很多国家凑成一个整体时，好像抗击风险的能力更强了，这好像符合风险分散的理论。但实际上，当经济发生中周期调整时，这些国家几乎会同时变差，因而不具有分散风险的功能。", "bookVersion": 1748903449, "range": "10947-10951", "abstract": "欧元幻觉", "type": 1, "chapterUid": 15, "chapterName": "10 美元破百的全球影响", "chapterIdx": 15, "reviewId": "39578508_87TiWy4zA", "userVid": 39578508, "topics": [], "createTime": 1774513516, "contextAbstract": "面由于投资者仍然存在欧元幻觉[插图]。\n美元将", "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "10 美元破百的全球影响", "author": {"userVid": 39578508, "name": "Ducoup", "avatar": "https://res.weread.qq.com/wravatar/WV0016-K6fiyyD8M2inBAZbsHXcN9b/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "Ducoup", "isV": 0, "vDesc": "平平无奇野心家", "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "在书里环游世界", "medalInfo": {"id": "M14-0-500", "desc": "拯救书荒", "title": "佳作推荐官", "levelIndex": 500}}}, "likesCount": 6}]}, {"range": "12152-12247", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "64720176_8anYBhPUv", "review": {"abstract": "再来看美元与日元。在研究时间内，日元相对于美元升值了近70%，但这种关系是稳定的。波动中枢在1.15附近。由于美元对日元在中枢附近，所以通过图10-11我们很难确定日元相对于美元未来的走势。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterUid": 15, "content": "2011年时的结论，啊哈哈", "contextAbstract": "", "friendship": 0, "htmlContent": "2011年时的结论，啊哈哈", "isPrivate": 0, "notVisibleToFriends": 0, "range": "12152-12247", "title": "", "type": 1, "chapterName": "10 美元破百的全球影响", "chapterIdx": 15, "reviewId": "64720176_8anYBhPUv", "