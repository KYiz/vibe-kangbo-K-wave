wx.qlogo.cn/mmhead/OO4hxIIN2cV9OInRdyjDMxl2eJWCJ2xhTZcdHBAIiaOJBBTbtVMVJlyUqyuDricsFso9vXTSvRofk/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M3-0-100", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 100}}}}]}, {"range": "11737-11750", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 3, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "4456513_8c58FqiSU", "review": {"abstract": "真实需求的开端总是在于中游", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "06 结构主义的薪火 周期波动、结构演进与制度变革", "chapterUid": 11, "content": "周金涛强调“真实需求的开端总是在于中游”，主要基于以下逻辑：\n\n​​库存周期转换的起点在中游​​\n• 二次去库存结束后，经济从被动去库存转向主动补库存。主动补库存由企业根据真实需求自行驱动，而最先感受到需求变化、并据此决定投资和生产的是处于产业链中间环节的中游企业。因此，真实需求的“火花”首先在中游被点燃。\n\n​​中游行业连接上下游，最能反映需求端的微观变化​​\n• 中游企业既向上游采购原材料，又向下游销售半成品或设备。当终端需求开始回升时，中游最先获得订单、看到价格改善，从而带动采购与投资活动。这种“传导枢纽”地位使得中游成为真实需求扩张的先行者。\n\n​​固定资产投资结构向下端转移，进一步放大中游需求​​\n• 在长波衰退阶段，重化工业等上游资本品投资受资源、技术和政策约束，增速趋缓；而机械设备、交通运输设备等中游偏下行业投资效率更高、需求弹性更大，未来将成为固定资产投资的重心。投资结构的这一转向，使中游成为新一轮中周期需求扩张的主战场。\n\n​​微观主体的自发投资行为构成真实需求的核心​​\n• 与政府主导的宏观刺激不同，真实需求来自企业为提升效率、获取利润的自发投资。这类投资首先出现在对价格和订单最敏感、最贴近终端市场的中游环节，从而进一步印证“真实需求的开端在于中游”。\n\n综合来看，中游企业在库存周期转换、产业链传导和固定资产投资结构重塑中处于独特位置，既是最早感受到需求变化的环节，也是带动整体需求回升的关键力量，因此周金涛才强调“真实需求的开端总是在于中游”。\n\n", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "11737-11750", "createTime": 1789272162, "title": "", "type": 1, "chapterIdx": 11, "reviewId": "4456513_8c58FqiSU", "userVid": 4456513, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "cha