, "author": {"userVid": 563905494, "name": "oiioᐝ", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/PiajxSqBRaEJ4wSuvkkEQvYMe8pqbN571qsuDrZXh4AO7fKwicUnWwT3gvMuNkP3VePJZrJdZFKQEjDKFRu1niby9Cr4vl6gicXoH9gboa1OXI8NqqAqNProYA/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M9-0-5", "desc": "阅读神作", "title": "神作研习生", "levelIndex": 5}}}, "likesCount": 7, "commentsCount": 2, "hotComments": []}, {"reviewId": "65205275_84zWDnyPw", "review": {"abstract": "在其他国家相继调低利率之时，美国利率保持较高水平，吸引了大量国际资金，从而有力地支持了美元汇率。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "第二部分 大类资产配置", "chapterUid": 14, "content": "美元回流", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "15213-15261", "createTime": 1762849029, "title": "", "type": 1, "chapterIdx": 14, "reviewId": "65205275_84zWDnyPw", "userVid": 65205275, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "第二部分 大类资产配置", "author": {"userVid": 65205275, "name": "神经蛙", "avatar": "https://res.weread.qq.com/wravatar/WV0005-v6QSiX2WgWMq1Ne9tHwlb10/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "nick": "神经蛙", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M1-0-1000", "desc": "连续阅读", "title": "连续阅读", "levelIndex": 1000}}}, "likesCount": 3}, {"reviewId": "260503178_8bH5A9C9u", "review": {"bookId": "3300128305", "content": "现在这一套已经玩不转了 陷入美债螺旋 暴力加息最先崩溃的是美国自己 已经没有经济体可以帮美国转嫁危机了", "bookVersion": 1748903449, "range": "15163-15261", "abstract": "1984年，美国联邦储备银行的贴现率一直维持在8%～9%，商业银行的优惠放款利率则在10%上下波动。在其他国家相继调低利率之时，美国利率保持较高水平，吸引了大量国际资金，从而有力地支持了美元汇率。", "type": 1, "onlyVisibleOneBook": 1, "chapterUid": 14, "chapterName": "第二部分 大类资产配置", "chapterIdx": 14, "reviewId": "260503178_8bH5A9C9u", "userVid": 260503178, "topics": [], "createTime": 1787906130, "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "第二部分 大类资产配置", "author": {"userVid": 260503178, "name": "⛈️", "avatar": "https://res.weread.qq.com/wravatar/WV0029-vjTd9AJ5XNpIUl03jiW0a10/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "⛈️", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": false, "deepVTitle": "", "signature": "河伯见北海若", "medalInfo": {"id": "M4-0-100", "desc": "阅读书籍", "title": "阅读书籍", "levelIndex": 100}}}}]}, {"range": "15738-15794", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "254854030_87UL25RDA", "review": {"type": 1, "bookId": "3300128305", "chapterUid": 14, "content": "美国作为当时全球最大的消费市场和经济体，在1983到1984年实现了超强的经济增长，国内消费和工业生产大幅扩张，直接带来了对欧洲商品、机械设备、汽车、化工产品等进口需求的显著增加，欧洲作为美国最主要的贸易伙伴之一，外需的回暖首先拉动了出口导向型较强的联邦德国、英国等国的工业生产，企业订单增多之后开始逐步恢复生产、扩大用工，进而带动居民收入和国内消费的回升，形成实体经济层面的复苏链条。同时美国实行的高利率政策虽然吸引了全球资本流向美国，但随着美国经济复苏的势头不断确认，全球金融市场的风险偏好明显提升，原本恐慌性撤离欧洲的资本开始逐步回流，缓解了欧洲国家的融资压力和汇率压力，为欧洲企业投资和政府稳定经济提供了有利的金融环境，再加上美国经济强劲复苏带来的全球经济信心提振让欧洲企业和消费者对未来的预期逐渐改善，不再持续收缩开支和投资，这种市场信心的传导也进一步推动欧洲国家慢慢走出危机低谷。只不过欧洲自身存在结构性问题、政策调整力度不及美国，所以复苏的速度和强度都远远落后于美国，呈现出美国先复苏、欧洲滞后跟随、且复苏力度明显偏弱的格局。", "bookVersion": 1748903449, "abstract": "在美国经济回升的带动下，英国从1982年12月，联邦德国、卢森堡、荷兰、比利时等西欧国家从1983年初开始回升。", "range": "15738-15794", "chapterName": "第二部分 大类资产配置", "chapterIdx": 14, "reviewId": "254854030_87UL25RDA", "userVid": 254854030, "topics": [], "createTime": 1774596050, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "第二部分 大类资产配置", "author": {"userVid": 254854030, "name": "薄荷白桃乌龙茶", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/DYAIOgq83eotCrwSFSicibG99Nkf5vrg0ff5gIBNXvxUEHLjQOgqCkgge06Nib9Vp2791QZZJPKUpm1JVpXRn1RoA/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M13-20240826-10", "desc": "每周阅读挑战", "title": "完美阅读周", "levelIndex": 10}}}, "likesCount": 4}]}, {"range": "17356-17373", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 1, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "514007366_8bcvxb3Rp", "review": {"type": 1, "bookId": "3300128305", "chapterUid": 14, "content": "“欧美强弱差异是美元强势的直接且根本的原因：美国相对更强 → 美元升值；欧洲相对更强 → 欧元等货币受益，美元走弱。在跨资产配置时，若想判断美元周期，先看欧美经济节奏的分化，再结合利率、贸易与市场情绪。”", "bookVersion": 1748903449, "abstract": "欧美的强弱差异是美元强势的基本原因", "range": "17356-17373", "chapterName": "第二部分 大类资产配置", "chapterIdx": 14, "reviewId": "514007366_8bcvxb3Rp", "userVid": 514007366, "topics": [], "createTime": 1786169098, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "