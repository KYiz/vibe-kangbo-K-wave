en/vi_32/DYAIOgq83eotCrwSFSicibG99Nkf5vrg0ff5gIBNXvxUEHLjQOgqCkgge06Nib9Vp2791QZZJPKUpm1JVpXRn1RoA/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M13-20240826-10", "desc": "每周阅读挑战", "title": "完美阅读周", "levelIndex": 10}}}, "likesCount": 1}]}, {"range": "25072-25145", "bookMarkCount": 0, "maxIdx": 0, "totalCount": 3, "hasMore": 0, "synckey": 1793261222, "pageReviews": [{"reviewId": "17130191_88emrGdm3", "review": {"bookId": "3300128305", "content": "扎心的事实是：大部分普通人使用财富的效率太低或者根本没有任何途径进行扩大再生产，让这些财富发挥效用。所以银行，股市等等机构收归起这些财富，统一起来分配给有能力“利用”的个体或者企业。大部分个体享受的是整个生产力水平提高，所带来的beta，简单的说：只有少部分人能超额享受时代带来的机遇。", "bookVersion": 1748903449, "range": "25072-25145", "abstract": "1958年之后开始向一般民众公开售股集资。这都充分说明，随着工业化发展，实体经济对虚拟经济，特别是资本市场的需求度提高，资本市场的重要性日益提高。", "type": 1, "chapterUid": 7, "chapterName": "02 繁荣的起点 工业化转型期的投资全景", "chapterIdx": 7, "reviewId": "17130191_88emrGdm3", "userVid": 17130191, "topics": [], "createTime": 1775709529, "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "02 繁荣的起点 工业化转型期的投资全景", "author": {"userVid": 17130191, "name": "hahaisnotahah", "avatar": "https://res.weread.qq.com/wravatar/WV0001-SYZVs9GvEBUQ6eiBMFrAxfb/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "hahaisnotahah", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M3-0-500", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 500}}}, "likesCount": 4}, {"reviewId": "21498037_8cZtjCRUP", "review": {"bookId": "3300128305", "cont