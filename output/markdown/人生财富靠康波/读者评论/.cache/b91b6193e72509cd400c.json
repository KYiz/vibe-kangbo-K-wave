ent": "", "isPrivate": 0, "notVisibleToFriends": 0, "range": "17963-18045", "createTime": 1768269553, "title": "", "type": 1, "chapterIdx": 16, "reviewId": "221256531_867nnw8M5", "userVid": 221256531, "topics": [], "flag": 0, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapterTitle": "11 世界大宗商品周期研究", "author": {"userVid": 221256531, "name": "日新", "avatar": "https://res.weread.qq.com/wravatar/WV0024-H0wIa3C1cUHj2teJ~F91Pa4/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "日新", "isV": 0, "vDesc": "茶，书，乐。", "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "日拱一卒", "medalInfo": {"id": "M3-0-1000", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 1000}}}, "likesCount": 8}, {"reviewId": "259153360_876icBYgQ", "review": {"abstract": "牛鞭效应的基本思想是：当供应链上的各节点企业只根据来自其相邻的下级企业的需求信息进行生产或者供应决策时，需求信息的不真实性会沿着供应链逆流而上，产生逐级放大的现象。", "atUserVids": [], "bookId": "3300128305", "bookVersion": 1748903449, "chapterName": "11 世界大宗商品周期研究", "chapterUid": 16, "content": "牛鞭效应～", "contextAbstract": "", "friendship": 0, "htmlContent": "", "isPrivate": 0, "notVisibleToFriends": 0, "onlyVisibleOneBook": 1, "range": "17963-18045", "createTime": 1771729625, "title": "", "type": 1, "chapterIdx": 16, "reviewId": "259153360_876icBYgQ", "userVid": 259153360, "topics": [], "flag": 1073741824, "isLike": 0, "isReposted": 0, "book": {"bookId": "3300128305", "format": "epub", "version": 1748903449, "soldout": 0, "bookStatus": 1, "type": 0, "cover": "https://cdn.weread.qq.com/weread/cover/75/cpplatform_tpwzkagpzrvbkwwpe2swrf/s_cpplatform_tpwzkagpzrvbkwwpe2swrf1735290012.jpg", "title": "人生财富靠康波", "author": "周金涛", "payType": 1048577}, "chapter