WV0025-IEAAIa2G4V2WExdxAitlHe8/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "马胖", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M5-0-10", "desc": "读完书籍", "title": "读完书籍", "levelIndex": 10}}, "replyUser": {"userVid": 219289523, "name": "。", "avatar": "https://wx.qlogo.cn/mmhead/aXUpZVUYfjw7MINnvEtLAf5mQlWHk8XibriclVtKiatGU5goia7s4UWvzU1gsibia4N12oKn4Je1BTIn8/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": ""}}, {"reviewId": "276023870_866zN7kmw", "content": "你说的有色金属翻倍很有可能是因为战争，而不是真正的需求，这是萧条期的特征：价格波动极其剧烈。今天因为听说哪里打仗了暴涨50%，明天因为听说经济数据衰退又会暴跌40%。这是我自己的理解，我也不是什么高手不一定准确", "toUserVid": 219289523, "toCommentId": "276023870_866zN7kmw_c219289523_86hq7cR7P", "commentId": "276023870_866zN7kmw_c276023870_86hVsQJcY", "userVid": 276023870, "createTime": 1768868783, "likesCount": 3, "isLike": 0, "author": {"userVid": 276023870, "name": "耕心若溪", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/PiajxSqBRaEJibQhvqnuGLLR8pAkWtibbs16LcLIwhz4klZ22YTLalWl20NvBS4AwmK7iaALL72OLCg7S6OaFfGtVArwaLsrvPq8OMoSHX7sPVriaqsSdOwndCg/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "耕心若溪", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M12-0-0-B-6-6-1", "desc": "世界读书日", "title": "世界读书日", "levelIndex": 0}}, "replyUser": {"userVid": 219289523, "name": "。", "avatar": "https://wx.qlogo.cn/mmhead/aXUpZVUYfjw7MINnvEtLAf5mQlWHk8XibriclVtKiatGU5goia7s4UWvzU1gsibia4N12oKn4Je1BTIn8/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": ""}}, {"reviewId": "276023870_866zN7kmw", "content": "明年整体规划在智能，科技，电力等领域，作为工业属性的有色金属价格上涨，即使不因为外部战争，内部需要合理的上涨是正常逻辑吧，？期待各位的书友给些论点等，，", "toUserVid": 276023870, "toCommentId": "276023870_866zN7kmw_c276023870_86hVsQJcY", "commentId": "276023870_866zN7kmw_c305425826_86wcwN3EJ", "userVid": 305425826, "createTime": 1769679618, "author": {"userVid": 305425826, "name": "Up", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTIw6RYicXecjzgnSaJiboyyA0BJVglpBvmwQ0ibEM04wKs3cEdIsE6aib5o133jdeew0kmOial9Suys3zA/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 1, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M3-0-200", "desc": "阅读天数", "title": "阅读天数", "levelIndex": 200}}, "replyUser": {"userVid": 276023870, "name": "耕心若溪", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/PiajxSqBRaEJibQhvqnuGLLR8pAkWtibbs16LcLIwhz4klZ22YTLalWl20NvBS4AwmK7iaALL72OLCg7S6OaFfGtVArwaLsrvPq8OMoSHX7sPVriaqsSdOwndCg/132", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "nick": "耕心若溪", "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": "", "medalInfo": {"id": "M12-0-0-B-6-6-1", "desc": "世界读书日", "title": "世界读书日", "levelIndex": 0}}}, {"reviewId": "276023870_866zN7kmw", "content": "当投资规划聚焦于AI、科技、电力这些实实在在的产业落地时，对上游有色金属的需求就是实打实的增长。\n只要中国乃至全世界这三个大趋势不变，作为上游有色金属的需求底盘就会很稳固，价格在合理区间内逐步抬升是大概率事件。\n不过要警惕的是当前地缘风险会对有色金属造成短中期的剧烈震荡。", "toUserVid": 305425826, "toCommentId": "276023870_866zN7kmw_c305425826_86wcwN3EJ", "commentId": "276023870_866zN7kmw_c314442061_87Hv8BxVa", "userVid": 314442061, "createTime": 1773843085, "likesCount": 2, "isLike": 0, "author": {"userVid": 314442061, "name": "对方正在输入...", "avatar": "https://res.weread.qq.com/wravatar/WV0029-97qgtLWUKpTvAhB5VSDIz10/0", "isFollowing": 0, "isFollower": 0, "isBlacking": 0, "isBlackBy": 0, "isHide": 0, "isV": 0, "roleTags": [], "followPromote": "", "isDeepV": true, "deepVTitle": "资深会员", "signature": ""}, "replyUser": {"userVid": 305425826, "na