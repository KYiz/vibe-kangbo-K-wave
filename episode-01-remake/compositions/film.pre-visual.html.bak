<template><style>
@font-face{font-family:Hive;src:url('assets/fonts/NotoSansSC-Regular.otf') format('opentype');font-weight:400}@font-face{font-family:Hive;src:url('assets/fonts/NotoSansSC-Bold.otf') format('opentype');font-weight:700}
@font-face{font-family:Editorial;src:url('assets/fonts/NotoSerifSC-VF.ttf') format('truetype');font-weight:300 900}#root{position:absolute;inset:0;width:1080px;height:1920px;overflow:hidden;background:#0c0e12;color:#f2eee4;font-family:Hive,sans-serif}
.scene{position:absolute;inset:0;overflow:hidden;visibility:hidden;background:radial-gradient(circle at 50% 45%,#23272b 0%,#15191e 46%,#0c0e12 92%)}#s1{visibility:visible}
.scene:before{content:'';position:absolute;inset:0;opacity:.22;background-image:linear-gradient(#3d59722b 2px,transparent 2px),linear-gradient(90deg,#3d59722b 2px,transparent 2px);background-size:90px 90px;mask-image:linear-gradient(180deg,transparent 0%,#000 28%,#000 82%,transparent 100%)}
.eyebrow{position:absolute;left:78px;top:132px;font-size:32px;letter-spacing:7px;font-weight:700;color:#a7b9b2}.title{position:absolute;left:76px;top:235px;width:930px;font-size:86px;line-height:1.28;font-weight:700;letter-spacing:-3px}.title .gold{color:#d1ab72}.title .red{color:#c97565}.title .cyan{color:#9bbab6}
.sub{position:absolute;left:80px;bottom:160px;width:920px;font-size:42px;line-height:1.4;color:#c7c6bd;font-weight:700}svg{position:absolute;left:0;top:620px;width:1080px;height:1020px}.line{fill:none;stroke:#f2eee4;stroke-width:9;stroke-linecap:round;stroke-linejoin:round}.goldLine{fill:none;stroke:#d1ab72;stroke-width:11;stroke-linecap:round;stroke-linejoin:round}.cyanLine{fill:none;stroke:#9bbab6;stroke-width:10;stroke-linecap:round;stroke-linejoin:round}.redLine{fill:none;stroke:#c97565;stroke-width:10;stroke-linecap:round;stroke-linejoin:round}.wipe{position:absolute;inset:0;background:#fff2d3;opacity:0;pointer-events:none}.hitbar{position:absolute;left:-20%;top:49%;width:140%;height:24px;background:#d1ab72;box-shadow:0 0 90px #d1ab72;transform:rotate(-8deg);opacity:0}.fracture{position:absolute;inset:0;pointer-events:none;opacity:0;background:linear-gradient(113deg,transparent 46%,#fff9e8 47%,#c97565 48%,transparent 49%),linear-gradient(67deg,transparent 52%,#fff9e8 53%,#d1ab72 54%,transparent 55%)}

/* Editorial motion direction: ink, aged paper, brushed brass, deliberate type. */
.scene{background:radial-gradient(ellipse at 72% 38%,#282a2a 0%,#171a1d 42%,#0c0e12 89%);box-shadow:inset 0 0 180px #0008}
.scene:nth-of-type(2){background:radial-gradient(ellipse at 78% 43%,#302b24 0%,#1b1b1b 48%,#0c0e12 91%)}
.scene:nth-of-type(3){background:radial-gradient(ellipse at 60% 52%,#2b2524 0%,#191a1c 46%,#0c0e12 91%)}
.scene:nth-of-type(5){background:radial-gradient(ellipse at 50% 55%,#252a28 0%,#191b1c 50%,#0c0e12 92%)}
.scene:nth-of-type(7){background:radial-gradient(ellipse at 62% 58%,#202b29 0%,#151a1b 48%,#0c0e12 92%)}
.scene:before{content:'';position:absolute;inset:0;opacity:.56;background:url('assets/grain.png') repeat;background-size:256px 256px;mask-image:none;pointer-events:none;mix-blend-mode:soft-light}
.scene:after{content:'';position:absolute;left:80px;right:80px;top:115px;height:1px;background:linear-gradient(90deg,#d1ab72aa,transparent);pointer-events:none}
.eyebrow{left:80px;top:135px;padding-left:24px;border-left:3px solid #d1ab72;color:#a7b9b2;font-size:29px;letter-spacing:6px;font-weight:400}
.title{font-family:Editorial,serif;font-size:89px;line-height:1.25;font-weight:650;letter-spacing:1px;text-shadow:0 9px 28px #0005}
.sub{font-size:37px;font-weight:400;letter-spacing:1px;border-top:1px solid #d1ab7266;padding-top:26px;bottom:137px;line-height:1.45}
.title .gold{color:#d8b47c}.title .red{color:#d88576}.title .cyan{color:#a8c7bd}
svg{filter:drop-shadow(0 23px 28px #0005)}svg rect{rx:5px}svg text{paint-order:stroke fill}
.goldLine,.cyanLine,.redLine{stroke-width:7;stroke-linecap:round}
#s1 svg{top:645px}#s2 svg{top:650px}#s3 svg{top:630px}#s4 svg{top:670px}#s5 svg{top:650px}#s6 svg{top:640px}#s7 svg{top:660px}
#s4 .title{top:210px}#s5 .title{top:210px}#s6 .title{top:210px}
/* Two inverted spreads interrupt the predictable title-over-icon rhythm. */
#s3 svg{top:280px}#s3 .title{top:1170px;font-size:96px}#s3 .sub{bottom:115px}
#s6 svg{top:285px}#s6 .title{top:1180px;font-size:82px}#s6 .sub{bottom:115px}
.scene:nth-of-type(8){background:radial-gradient(ellipse at 62% 44%,#2e2b25 0%,#191a1b 48%,#0c0e12 92%)}
.scene:nth-of-type(9){background:radial-gradient(ellipse at 44% 56%,#2b2926 0%,#191a1c 50%,#0c0e12 91%)}
.scene:nth-of-type(10){background:radial-gradient(ellipse at 66% 50%,#222d29 0%,#171b1b 50%,#0c0e12 91%)}
#s8 svg{top:290px}#s8 .title{top:1170px;font-size:94px}#s8 .sub{bottom:115px}
#s9 svg{top:650px}#s9 .title{top:225px}
#s10 svg{top:640px}#s10 .title{top:220px}
#s8-order-loss,#s8-job-shutter,#s9-reserve-loss,#s10-upper-stop,#s10-lower-stop{opacity:0}
.scene:nth-of-type(11){background:radial-gradient(ellipse at 62% 38%,#2b2924 0%,#191a1b 48%,#0c0e12 92%)}
.scene:nth-of-type(12){background:radial-gradient(ellipse at 42% 52%,#282825 0%,#191a1c 50%,#0c0e12 92%)}
.scene:nth-of-type(13){background:radial-gradient(ellipse at 50% 50%,#352e23 0%,#191a1c 55%,#0c0e12 94%)}
#s11 svg{top:285px}#s11 .title{top:1180px;font-size:88px}#s11 .sub{bottom:115px}
#s12 svg{top:640px}#s12 .title{top:225px}
#s13 svg{top:0;height:1920px}#s13 .title{top:220px;font-size:108px;z-index:2;opacity:0}#s13 .sub{z-index:2;opacity:0}
#s11-hidden-left,#s11-hidden-right,#s12-stamp,#s12-reverse,#s13-cracks,#s13-shards,#s13-routes{opacity:0}
.scene:nth-of-type(14){background:radial-gradient(ellipse at 66% 42%,#2c2b26 0%,#191b1d 52%,#0c0e12 92%)}
.scene:nth-of-type(15){background:radial-gradient(ellipse at 45% 55%,#26302d 0%,#191b1c 54%,#0c0e12 92%)}
.scene:nth-of-type(16){background:radial-gradient(ellipse at 60% 43%,#302d25 0%,#191b1c 54%,#0c0e12 92%)}
.scene:nth-of-type(17){background:radial-gradient(ellipse at 50% 54%,#302b26 0%,#17191c 56%,#0c0e12 94%)}
#s14 svg{top:270px}#s14 .title{top:1195px;font-size:87px;opacity:0}#s14 .sub{bottom:112px;opacity:0}
#s15 svg{top:650px}#s15 .title{top:225px;font-size:89px}
#s16 svg{top:630px}#s16 .title{top:225px;font-size:83px}
#s17 svg{top:0;height:1920px;filter:none}#s17 .title{top:520px;font-size:101px;line-height:1.35;z-index:2;opacity:0}#s17 .sub{bottom:230px;z-index:2;font-size:43px;opacity:0}
#s14-evidence,#s14-lens,#s15-card-a,#s15-card-b,#s15-card-c,#s15-route,#s16-card-b,#s16-card-c,#s16-card-d,#s16-links,#s17-paths{opacity:0}
#s17-paths rect,#s17-paths text{opacity:0}
.wipe{background:#ead9b7}.hitbar{height:10px;background:#d1ab72;box-shadow:0 0 60px #d1ab72}.fracture{background:linear-gradient(113deg,transparent 46%,#f0e6d6 47%,#c97565 48%,transparent 49%),linear-gradient(67deg,transparent 52%,#f0e6d6 53%,#d1ab72 54%,transparent 55%)}
</style><div id="root" data-composition-id="film" data-width="1080" data-height="1920">
<section class="scene" id="s1" data-layout-ignore><div class="eyebrow">01 / 一个问题</div><div class="title">同一年毕业，<br><span class="gold">为什么有人顺风</span><br>有人逆风？</div><svg viewBox="0 0 1080 1020" aria-label="同一年毕业的两封不同回信"><path d="M110 650H970" stroke="#436178" stroke-width="6"/><g id="diploma"><rect x="329" y="70" width="420" height="190" rx="16" fill="#e8decb" stroke="#d1ab72" stroke-width="9"/><path d="M390 140H690M390 185H620" stroke="#436178" stroke-width="8"/><text x="385" y="119" fill="#27292a" font-size="47" font-weight="700" font-family="Hive">毕业证</text><circle cx="690" cy="203" r="35" fill="#d1ab72"/></g><g id="letter-a"><rect x="115" y="410" width="375" height="280" rx="17" fill="#e8decb" stroke="#9bbab6" stroke-width="9"/><path d="M115 425L302 555L490 425" fill="none" stroke="#9bbab6" stroke-width="8"/><rect x="160" y="515" width="280" height="106" rx="10" fill="#d4e0d7"/><text x="225" y="585" fill="#3d6e68" font-size="53" font-weight="700" font-family="Hive">录用</text></g><g id="letter-b"><rect x="590" y="410" width="375" height="280" rx="17" fill="#e8decb" stroke="#c97565" stroke-width="9"/><path d="M590 425L777 555L965 425" fill="none" stroke="#c97565" stroke-width="8"/><rect x="635" y="515" width="280" height="106" rx="10" fill="#e9d0c2"/><text x="700" y="585" fill="#8f4b43" font-size="53" font-weight="700" font-family="Hive">缩招</text></g><g id="s1-question"><path d="M538 720L528 775" class="goldLine"/><circle cx="529" cy="832" r="9" fill="#d1ab72"/><text x="494" y="913" fill="#d1ab72" font-size="94" font-family="Hive" font-weight="700">?</text></g></svg><div class="sub">一个年份，真能决定一生吗？</div></section>
<section class="scene" id="s2" data-layout-ignore><div class="eyebrow">02 / 流行的解释</div><div class="title">有人说：答案都在<br><span class="gold">一条长波</span>里。</div><svg viewBox="0 0 1080 1020" aria-label="康波长期经济起伏的纸卷"><g id="s2-roll"><rect x="82" y="180" width="916" height="550" rx="30" fill="#e8decb" stroke="#d1ab72" stroke-width="10"/><rect x="82" y="160" width="76" height="592" rx="35" fill="#b69568"/><rect x="926" y="160" width="76" height="592" rx="35" fill="#b69568"/><text x="205" y="280" fill="#203144" font-size="54" font-family="Hive" font-weight="700">经济长期起伏</text><path id="longwave" d="M198 568 C320 305 422 650 540 510 S790 300 902 425" fill="none" stroke="#a77d4a" stroke-width="16" stroke-linecap="round"/><path d="M200 628H900" stroke="#718496" stroke-width="6"/><path d="M275 621V643M455 621V643M650 621V643M835 621V643" stroke="#718496" stroke-width="6"/><text x="235" y="690" fill="#4c6074" font-size="33" font-family="Hive">时间 →</text></g><g id="s2-stamp"><rect x="285" y="754" width="510" height="145" rx="18" fill="#c97565" transform="rotate(-6 540 825)"/><text x="363" y="855" fill="#f2eee4" font-family="Hive" font-size="87" font-weight="700" transform="rotate(-6 540 825)">康波 ？</text></g></svg><div class="sub">把几十年的变化，画成一条线。</div></section>
<section class="scene" id="s3" data-layout-ignore><div class="eyebrow">03 / 一个误读</div><div class="title">可它不是<br><span class="red">个人命运表。</span></div><svg viewBox="0 0 1080 1020" aria-label="出生年份预测财富的机器卡住并报错"><g id="s3-card"><rect x="88" y="215" width="280" height="225" rx="20" fill="#e8decb" stroke="#9bbab6" stroke-width="9"/><circle cx="162" cy="291" r="36" fill="none" stroke="#39546c" stroke-width="8"/><path d="M105 389C110 337 215 337 220 389" fill="none" stroke="#39546c" stroke-width="8"/><text x="235" y="305" fill="#2b3031" font-size="34" font-family="Hive">出生年</text><text x="236" y="365" fill="#2b3031" font-size="50" font-weight="700" font-family="Hive">19XX</text></g><g id="s3-machine"><rect x="420" y="120" width="560" height="575" rx="42" fill="#2a2e31" stroke="#a4bdc8" stroke-width="10"/><rect x="471" y="190" width="455" height="290" rx="17" fill="#151c21" stroke="#9bbab6" stroke-width="8"/><text x="516" y="290" fill="#c7c6bd" font-size="46" font-family="Hive">出生年 → 财富？</text><path d="M518 360H865" stroke="#436178" stroke-width="8"/><g id="s3-err"><path d="M690 346L735 390M735 346L690 390" stroke="#c97565" stroke-width="20" stroke-linecap="round"/><text x="610" y="456" fill="#c97565" font-size="50" font-weight="700" font-family="Hive">无法计算</text></g><rect x="535" y="540" width="340" height="48" rx="10" fill="#15191e"/><path d="M545 568H867" stroke="#d1ab72" stroke-width="12"/></g><g id="s3-jam" fill="#c97565"><path d="M359 343L410 300L392 355L435 392L380 389L355 444L342 392L288 379Z"/><path d="M485 681L515 726L472 718L445 770L439 714L392 697L446 683Z"/></g></svg><div class="sub">宏观曲线，不能直接算出你的结果。</div></section>
<section class="scene" id="s4" data-layout-ignore><div class="eyebrow">04 / 真正的传导</div><div class="title">它影响你，<br>要经过<span class="gold">几道门。</span></div><svg viewBox="0 0 1080 1020" aria-label="订单变化传到岗位机会再传到收入"><path id="s4-flow" d="M180 500H900" class="goldLine" stroke-dasharray="28 22"/><path d="M888 474L924 500L888 526" class="goldLine"/><g id="s4-orders"><rect x="75" y="310" width="290" height="365" rx="18" fill="#e8decb" stroke="#d1ab72" stroke-width="10"/><text x="118" y="377" fill="#2b3031" font-size="45" font-weight="700" font-family="Hive">订单</text><path d="M125 431H318M125 482H295M125 533H300" stroke="#456278" stroke-width="10"/><path d="M125 585H310" stroke="#c97565" stroke-width="17"/><text x="130" y="638" fill="#8f4b43" font-size="37" font-family="Hive">减少</text></g><g id="s4-jobs"><rect x="408" y="358" width="264" height="278" rx="24" fill="#272c30" stroke="#9bbab6" stroke-width="10"/><path d="M465 406H613M465 568H613" stroke="#9bbab6" stroke-width="8"/><text x="455" y="490" fill="#f2eee4" font-size="47" font-weight="700" font-family="Hive">招聘</text><g id="job-flip"><rect x="446" y="516" width="188" height="72" rx="9" fill="#c97565"/><text x="466" y="568" fill="#f2eee4" font-size="43" font-family="Hive" font-weight="700">缩招</text></g></g><g id="s4-wallet"><path d="M738 385H968V632H738Q706 632 706 600V417Q706 385 738 385Z" fill="#b99762" stroke="#d1ab72" stroke-width="10"/><path d="M755 430H963" stroke="#fff3d0" stroke-width="8"/><path id="money" d="M775 375V305H911V375" fill="#c6d6bd" stroke="#9bbab6" stroke-width="8"/><rect x="831" y="487" width="145" height="89" rx="16" fill="#2a2e31" stroke="#d1ab72" stroke-width="8"/><circle cx="879" cy="531" r="12" fill="#d1ab72"/></g><g font-family="Hive" font-size="38" font-weight="700"><text x="140" y="770" fill="#d1ab72">订单变化</text><text x="445" y="770" fill="#9bbab6">岗位机会</text><text x="778" y="770" fill="#d1ab72">收入</text></g></svg><div class="sub">订单 → 岗位 → 收入，才走到个人。</div></section>
<section class="scene" id="s5" data-layout-ignore><div class="eyebrow">05 / 为什么感受不同</div><div class="title">同一波动，<br><span class="gold">落点也不一样。</span></div><svg viewBox="0 0 1080 1020" aria-label="同一波动下两家店的订单与招聘反应不同"><path id="s5-wave" d="M-40 198C160 70 260 315 450 200S790 70 1120 195" class="goldLine" stroke-width="20"/><path d="M540 100V850" stroke="#476078" stroke-width="5" stroke-dasharray="20 20"/><g id="s5-left"><path d="M65 410H496V779H65Z" fill="#2c3032" stroke="#f2eee4" stroke-width="9"/><path d="M46 389L103 299H458L515 389Z" fill="#c97565"/><path d="M45 389H515" stroke="#f2eee4" stroke-width="10"/><rect x="143" y="475" width="275" height="204" rx="10" fill="#191d20" stroke="#7894a2" stroke-width="8"/><text x="154" y="552" fill="#dfab98" font-size="40" font-weight="700" font-family="Hive">订单减少</text><text x="173" y="625" fill="#f2eee4" font-size="47" font-weight="700" font-family="Hive">招聘收紧</text></g><g id="s5-right"><path d="M585 410H1017V779H585Z" fill="#2c3032" stroke="#f2eee4" stroke-width="9"/><path d="M566 389L623 299H978L1035 389Z" fill="#9bbab6"/><path d="M565 389H1035" stroke="#f2eee4" stroke-width="10"/><rect x="663" y="475" width="275" height="204" rx="10" fill="#191d20" stroke="#7894a2" stroke-width="8"/><text x="671" y="552" fill="#c3dbd1" font-size="40" font-weight="700" font-family="Hive">需求仍在</text><text x="693" y="625" fill="#f2eee4" font-size="47" font-weight="700" font-family="Hive">继续招聘</text></g><g id="s5-drops"><path d="M250 235L210 292M340 220L300 285M750 225L710 290M845 235L800 300" stroke="#d1ab72" stroke-width="13" stroke-linecap="round"/></g><text x="235" y="900" fill="#c97565" font-size="48" font-family="Hive" font-weight="700">行业 A</text><text x="752" y="900" fill="#9bbab6" font-size="48" font-family="Hive" font-weight="700">行业 B</text></svg><div class="sub">行业、岗位不同，影响可能不同。<span style="font-size:28px;color:#9fb0bd">（示意）</span></div></section>
<section class="scene" id="s6" data-layout-ignore><div class="eyebrow">06 / 预测的边界</div><div class="title">看得见过去的起伏，<br><span class="red">算不准下一次。</span></div><svg viewBox="0 0 1080 1020" aria-label="历史波峰间隔不等，未来标尺碎裂成多条虚线"><path d="M90 735H990" stroke="#7792a4" stroke-width="7"/><path d="M160 721V753M354 721V753M710 721V753M930 721V753" stroke="#7792a4" stroke-width="7"/><text x="105" y="820" fill="#c9d6da" font-size="28" font-family="Hive">过去</text><text x="855" y="820" fill="#c9d6da" font-size="28" font-family="Hive">未来 ?</text><path id="s6-history" d="M90 525C165 510 190 270 255 275S345 615 433 570S560 310 625 314S680 505 710 470" class="goldLine" stroke-width="18"/><circle cx="255" cy="275" r="18" fill="#d1ab72"/><circle cx="625" cy="314" r="18" fill="#d1ab72"/><path id="s6-future-a" d="M710 470C790 260 850 310 980 240" class="cyanLine" stroke-dasharray="20 25"/><path id="s6-future-b" d="M710 470C820 500 850 425 980 470" class="cyanLine" stroke-dasharray="20 25"/><path id="s6-future-c" d="M710 470C790 660 880 610 980 685" class="cyanLine" stroke-dasharray="20 25"/><g id="s6-ruler"><rect x="244" y="640" width="545" height="72" rx="9" fill="#ddc79f" stroke="#d1ab72" stroke-width="8"/><path d="M300 640V675M355 640V692M410 640V675M465 640V692M520 640V675M575 640V692M630 640V675M685 640V692M740 640V675" stroke="#7c673c" stroke-width="6"/><text x="370" y="625" fill="#d1ab72" font-size="36" font-family="Hive">按固定年数推算？</text></g><g id="s6-splits" fill="#c97565"><path d="M530 690L460 760L500 700Z"/><path d="M540 675L590 770L550 710Z"/><path d="M520 680L500 605L545 650Z"/></g></svg><div class="sub">转折点常在事后确认，间隔也不固定。</div></section>
<section class="scene" id="s7" data-layout-ignore><div class="eyebrow">07 / 更有用的做法</div><div class="title">看环境、看自己，<br><span class="cyan">给选择留余地。</span></div><svg viewBox="0 0 1080 1020" aria-label="毕业生在风险地图上标出行业风险、个人缓冲和行动路径"><g id="s7-map"><path d="M85 192L380 130L694 200L1000 128V745L694 818L380 744L85 810Z" fill="#e0d5bf" stroke="#d1ab72" stroke-width="10"/><path d="M380 130V744M694 200V818" stroke="#a9a395" stroke-width="7"/><path d="M110 315C245 330 265 580 405 540S590 350 700 420S855 700 980 640" fill="none" stroke="#b3b6aa" stroke-width="18" stroke-dasharray="30 25"/><g id="s7-risk"><circle cx="256" cy="365" r="70" fill="#c97565" opacity=".24"/><circle cx="256" cy="365" r="24" fill="#c97565"/><text x="157" y="280" fill="#8f4b43" font-size="40" font-weight="700" font-family="Hive">行业风险</text></g><g id="s7-buffer"><path d="M515 460L560 435L605 460V535Q560 568 515 535Z" fill="#9bbab6" opacity=".55" stroke="#1b6671" stroke-width="8"/><text x="463" y="405" fill="#416d66" font-size="40" font-weight="700" font-family="Hive">个人缓冲</text></g><path id="s7-route" d="M255 365C350 420 410 560 565 500S770 395 865 595" fill="none" stroke="#567e78" stroke-width="20" stroke-linecap="round"/><g id="s7-person"><circle cx="865" cy="595" r="40" fill="#293d3b" stroke="#9bbab6" stroke-width="9"/><path d="M803 675C814 620 914 620 927 675" fill="#293d3b" stroke="#9bbab6" stroke-width="9"/></g><text x="745" y="357" fill="#416d66" font-size="40" font-weight="700" font-family="Hive">下一步</text></g></svg><div class="sub">周期影响机会，<span style="color:#d1ab72">不决定命运。</span></div></section>
<section class="scene" id="s8" data-layout-ignore><div class="eyebrow">08 / 看需求</div><div class="title">先看真实需求，<br><span class="gold">别猜年份。</span></div><svg viewBox="0 0 1080 1020" aria-label="企业需求看板上订单登记变少，招聘岗位收紧"><g id="s8-board"><rect x="75" y="115" width="930" height="680" fill="#292b2b" stroke="#d1ab72" stroke-width="8"/><path d="M100 225H980M100 500H980" stroke="#9c8e75" stroke-width="5"/><circle cx="118" cy="155" r="9" fill="#d1ab72"/><circle cx="962" cy="155" r="9" fill="#d1ab72"/><text x="145" y="194" fill="#f2eee4" font-family="Hive" font-size="50" font-weight="700">企业需求看板</text><text x="140" y="342" fill="#f2eee4" font-family="Hive" font-size="47">订单</text><text x="140" y="627" fill="#f2eee4" font-family="Hive" font-size="47">招聘</text><g id="s8-orders" fill="#d1ab72"><rect x="365" y="310" width="86" height="100"/><rect x="468" y="310" width="86" height="100"/><rect x="571" y="310" width="86" height="100"/><rect x="674" y="310" width="86" height="100"/><rect x="777" y="310" width="86" height="100"/></g><g id="s8-order-loss" fill="#be7667"><path d="M680 300L746 420M746 300L680 420" stroke="#be7667" stroke-width="12"/><path d="M784 300L851 420M851 300L784 420" stroke="#be7667" stroke-width="12"/></g><g id="s8-job-slot" fill="none" stroke="#a8c3bc" stroke-width="7"><rect x="365" y="565" width="130" height="115"/><rect x="515" y="565" width="130" height="115"/><rect x="665" y="565" width="130" height="115"/><rect x="815" y="565" width="130" height="115"/></g><g id="s8-job-shutter"><rect x="525" y="570" width="410" height="106" fill="#bd7365"/><text x="613" y="644" fill="#f2eee4" font-family="Hive" font-size="53" font-weight="700">招聘收紧</text></g><path id="s8-link" d="M325 385C430 455 540 478 678 510" fill="none" stroke="#d1ab72" stroke-width="8" stroke-linecap="round"/><path d="M660 486L689 512L649 518" fill="none" stroke="#d1ab72" stroke-width="8" stroke-linecap="round"/></g></svg><div class="sub">订单和招聘，比年份标签更接近眼前机会。</div></section>
<section class="scene" id="s9" data-layout-ignore><div class="eyebrow">09 / 量缓冲</div><div class="title">再看自己，<br><span class="red">能扛多久。</span></div><svg viewBox="0 0 1080 1020" aria-label="家庭账本里固定支出持续出现，收入波动消耗备用现金"><g id="s9-ledger"><path d="M88 180L514 130L990 184V790L514 840L88 788Z" fill="#e4dac8" stroke="#d1ab72" stroke-width="9"/><path d="M514 130V840" stroke="#a69a85" stroke-width="7"/><text x="147" y="260" fill="#343533" font-family="Hive" font-size="50" font-weight="700">每月固定支出</text><text x="609" y="260" fill="#343533" font-family="Hive" font-size="50" font-weight="700">备用现金</text><g id="s9-bill-a"><rect x="153" y="330" width="274" height="108" fill="#f3eee2" stroke="#b8aa90" stroke-width="6"/><text x="210" y="401" fill="#57554c" font-family="Hive" font-size="44">房租</text><path d="M334 369H389" stroke="#c97565" stroke-width="10"/></g><g id="s9-bill-b"><rect x="153" y="470" width="274" height="108" fill="#f3eee2" stroke="#b8aa90" stroke-width="6"/><text x="210" y="541" fill="#57554c" font-family="Hive" font-size="44">生活</text><path d="M334 509H389" stroke="#c97565" stroke-width="10"/></g><path d="M600 336H921M600 438H921M600 540H921M600 642H921" stroke="#b4ad99" stroke-width="6"/><g id="s9-reserve" fill="#d1ab72"><rect x="609" y="346" width="300" height="65"/><rect x="609" y="448" width="300" height="65"/><rect x="609" y="550" width="300" height="65"/><rect x="609" y="652" width="300" height="65"/></g><g id="s9-reserve-loss" fill="#c97565"><rect x="609" y="550" width="300" height="65"/><rect x="609" y="652" width="300" height="65"/></g><text x="636" y="770" fill="#57554c" font-family="Hive" font-size="35">还能转身的空间</text></g><path id="s9-shock" d="M-20 865C135 710 210 960 375 790S650 960 830 800S1000 760 1120 870" fill="none" stroke="#c97565" stroke-width="20" stroke-linecap="round"/></svg><div class="sub">固定支出与备用现金，决定转身空间。</div></section>
<section class="scene" id="s10" data-layout-ignore><div class="eyebrow">10 / 留后路</div><div class="title">让下一步，<br><span class="cyan">不止一条。</span></div><svg viewBox="0 0 1080 1020" aria-label="从现岗位出发的路线图，分出相邻岗位与新技能两条备选路线"><g id="s10-map"><path d="M78 115L378 160L693 105L1000 160V795L693 750L378 820L78 765Z" fill="#e3d9c4" stroke="#d1ab72" stroke-width="9"/><path d="M378 160V820M693 105V750" stroke="#aaa18f" stroke-width="6"/><path d="M130 690H945" stroke="#b4ad9d" stroke-width="5" stroke-dasharray="20 22"/><path id="s10-main" d="M190 580C290 580 350 550 500 550" fill="none" stroke="#b99762" stroke-width="22" stroke-linecap="round"/><path id="s10-upper" d="M500 550C630 545 695 350 850 320" fill="none" stroke="#6d938a" stroke-width="20" stroke-linecap="round"/><path id="s10-lower" d="M500 550C650 585 690 700 850 710" fill="none" stroke="#6d938a" stroke-width="20" stroke-linecap="round"/><circle cx="500" cy="550" r="22" fill="#d1ab72"/><g id="s10-upper-stop"><circle cx="850" cy="320" r="35" fill="#e3d9c4" stroke="#6d938a" stroke-width="11"/><text x="685" y="255" fill="#365951" font-family="Hive" font-size="43" font-weight="700">相邻岗位</text></g><g id="s10-lower-stop"><circle cx="850" cy="710" r="35" fill="#e3d9c4" stroke="#6d938a" stroke-width="11"/><text x="730" y="665" fill="#365951" font-family="Hive" font-size="43" font-weight="700">新技能</text></g><g id="s10-person"><circle cx="190" cy="580" r="34" fill="#2a403c" stroke="#d1ab72" stroke-width="10"/><path d="M135 660C140 615 240 615 245 660" fill="#2a403c" stroke="#d1ab72" stroke-width="10"/></g><text x="112" y="515" fill="#504b3f" font-family="Hive" font-size="43" font-weight="700">现岗位</text></g></svg><div class="sub">能迁移的能力，让选择有备选。</div></section>
<section class="scene" id="s11" data-layout-ignore><div class="eyebrow">11 / 被看见的样本</div><div class="title">别只看<br><span class="gold">被讲出的赢家。</span></div><svg viewBox="0 0 1080 1020" aria-label="一份成功案例被聚光，其他人生档案从背后展开"><g id="s11-hidden-left"><path d="M85 320L505 230L580 725L170 815Z" fill="#d6cbb8" stroke="#a78c63" stroke-width="8"/><text x="105" y="448" fill="#423c32" font-family="Hive" font-size="34" font-weight="700" transform="rotate(-8 105 448)">其他故事</text><path d="M155 650C245 500 310 710 448 470" fill="none" stroke="#a9aaa0" stroke-width="12" stroke-linecap="round"/><path d="M157 700H465" stroke="#b4a997" stroke-width="5"/></g><g id="s11-hidden-right"><path d="M495 245L935 315L850 825L435 730Z" fill="#d8cdb9" stroke="#a78c63" stroke-width="8"/><path d="M585 520C675 725 775 470 865 650" fill="none" stroke="#9eaaa4" stroke-width="12" stroke-linecap="round"/><path d="M565 700H835" stroke="#b4a997" stroke-width="5"/></g><g id="s11-winner"><rect x="258" y="164" width="565" height="570" fill="#e8decb" stroke="#d1ab72" stroke-width="10"/><path d="M285 280H795M285 665H795" stroke="#a48d68" stroke-width="5"/><text x="315" y="246" fill="#35342f" font-family="Hive" font-size="51" font-weight="700">成功案例</text><path d="M330 590C430 590 440 505 520 490S630 420 745 335" fill="none" stroke="#b99762" stroke-width="17" stroke-linecap="round"/><path d="M720 337L749 330L738 365" fill="none" stroke="#b99762" stroke-width="11"/><text x="315" y="714" fill="#695d4b" font-family="Hive" font-size="34">同一年 · 某个人</text></g><path id="s11-light" d="M285 0L770 0L850 740L200 740Z" fill="#d1ab72" opacity=".12"/></svg><div class="sub">一个成功案例，代表不了同年所有人。</div></section>
<section class="scene" id="s12" data-layout-ignore><div class="eyebrow">12 / 事后解释</div><div class="title">事后解释，<br><span class="red">最像预言。</span></div><svg viewBox="0 0 1080 1020" aria-label="先知道成功结果，再用箭头倒推出生年份并盖上必然问号"><g id="s12-paper"><rect x="88" y="145" width="905" height="655" fill="#e7ddca" stroke="#d1ab72" stroke-width="9"/><path d="M118 260H963M118 710H963" stroke="#b5a68d" stroke-width="5"/><text x="146" y="225" fill="#34342f" font-family="Hive" font-size="48" font-weight="700">案例回顾</text><rect x="144" y="340" width="320" height="230" fill="#f1eadc" stroke="#b4a68c" stroke-width="7"/><rect x="614" y="340" width="320" height="230" fill="#f1eadc" stroke="#b4a68c" stroke-width="7"/><text x="188" y="414" fill="#655f53" font-family="Hive" font-size="37">出生年份</text><text x="245" y="505" fill="#34342f" font-family="Hive" font-size="62" font-weight="700">19XX</text><text x="657" y="414" fill="#655f53" font-family="Hive" font-size="37">结果已知</text><text x="693" y="510" fill="#9c7045" font-family="Hive" font-size="65" font-weight="700">成功</text><path id="s12-reverse" d="M737 625C610 740 392 740 235 625" fill="none" stroke="#c97565" stroke-width="12" stroke-linecap="round"/><path d="M255 605L225 625L259 644" fill="none" stroke="#c97565" stroke-width="12" stroke-linecap="round"/></g><g id="s12-stamp"><rect x="380" y="578" width="350" height="150" fill="none" stroke="#b35f54" stroke-width="15" transform="rotate(-8 555 653)"/><text x="440" y="670" fill="#b35f54" font-family="Hive" font-size="70" font-weight="700" transform="rotate(-8 555 653)">必然？</text></g></svg><div class="sub">先知道结局，过去就显得“早该看出来”。</div></section>
<section class="scene" id="s13" data-layout-ignore><div class="eyebrow">13 / 重新判断</div><div class="title">故事，<br><span class="gold">不是公式。</span></div><svg viewBox="0 0 1080 1920" aria-label="年份等于财富的公式牌破碎，背后出现从同一年出发的不同路径"><g id="s13-routes"><circle cx="520" cy="1110" r="38" fill="#e8decb" stroke="#d1ab72" stroke-width="11"/><rect x="398" y="1167" width="245" height="74" fill="#e8decb" stroke="#d1ab72" stroke-width="7"/><text x="424" y="1219" fill="#363731" font-family="Hive" font-size="43" font-weight="700">同一年</text><path id="s13-route-a" d="M520 1110C380 990 300 910 205 795" fill="none" stroke="#b99762" stroke-width="18" stroke-linecap="round"/><path id="s13-route-b" d="M520 1110C660 980 715 930 865 955" fill="none" stroke="#9bbab6" stroke-width="18" stroke-linecap="round"/><path id="s13-route-c" d="M520 1110C570 1300 710 1360 840 1480" fill="none" stroke="#c97565" stroke-width="18" stroke-linecap="round"/><g id="s13-people" fill="#e8decb" stroke="#d1ab72" stroke-width="7"><circle cx="205" cy="780" r="26"/><path d="M150 852C165 812 245 812 260 852Z"/><circle cx="865" cy="940" r="26"/><path d="M810 1012C825 972 905 972 920 1012Z"/><circle cx="840" cy="1470" r="26"/><path d="M785 1542C800 1502 880 1502 895 1542Z"/></g></g><g id="s13-plaque"><rect x="130" y="745" width="820" height="440" fill="#c8a16b" stroke="#f1e6d2" stroke-width="13"/><rect x="165" y="780" width="750" height="370" fill="none" stroke="#826a49" stroke-width="5"/><text x="205" y="1015" fill="#26241f" font-family="Editorial" font-size="112" font-weight="700">年份＝财富</text></g><g id="s13-cracks" fill="none" stroke="#251f19" stroke-width="19" stroke-linecap="round"><path d="M280 762L395 915L347 1040L505 1170"/><path d="M720 745L620 900L760 990L635 1185"/><path d="M510 748L545 900L470 1030L530 1180"/></g><g id="s13-shards" fill="#d1ab72" stroke="#f1e6d2" stroke-width="6"><path d="M160 835L350 795L290 1030Z"/><path d="M768 805L940 745L890 1000Z"/><path d="M235 1080L430 1050L355 1240Z"/><path d="M660 1060L905 1120L760 1230Z"/></g></svg><div class="sub">一个人的结果，推不出所有人的命运。</div></section>
<section class="scene" id="s14" data-layout-ignore>
  <div class="eyebrow">14 / 把问题换掉</div>
  <div class="title">别问周期走到哪，<br><span class="gold">先问机会从哪来。</span></div>
  <svg viewBox="0 0 1080 1020" aria-label="写着年份的日历退开，露出订单、岗位、收入三项观察线索">
    <g id="s14-calendar"><rect x="250" y="100" width="580" height="720" fill="#e6dac4" stroke="#d1ab72" stroke-width="10"/><path d="M250 205H830" stroke="#b1a58c" stroke-width="7"/><circle cx="365" cy="145" r="18" fill="#a97f50"/><circle cx="715" cy="145" r="18" fill="#a97f50"/><text x="359" y="460" fill="#3d3930" font-family="Editorial" font-size="150" font-weight="700">20XX</text><path d="M350 555H730" stroke="#9b8f7a" stroke-width="6"/><text x="344" y="665" fill="#8f6950" font-family="Hive" font-size="52" font-weight="700">哪年最有利？</text></g>
    <g id="s14-evidence"><rect x="145" y="145" width="790" height="690" fill="#e5dccb" stroke="#d1ab72" stroke-width="10"/><text x="205" y="232" fill="#34342f" font-family="Hive" font-size="51" font-weight="700">眼前的线索</text><path d="M190 273H890M190 448H890M190 620H890" stroke="#ada18e" stroke-width="6"/><text x="220" y="360" fill="#34342f" font-family="Hive" font-size="55">订单</text><text x="220" y="535" fill="#34342f" font-family="Hive" font-size="55">岗位</text><text x="220" y="705" fill="#34342f" font-family="Hive" font-size="55">收入</text><path d="M530 340H820M530 515H820M530 690H820" stroke="#bdad90" stroke-width="9" stroke-linecap="round"/><circle cx="740" cy="340" r="18" fill="#d1ab72"/><circle cx="670" cy="515" r="18" fill="#9bbab6"/><circle cx="600" cy="690" r="18" fill="#c97565"/></g>
    <g id="s14-lens"><circle cx="740" cy="340" r="100" fill="#f5ecd5" fill-opacity=".13" stroke="#d1ab72" stroke-width="12"/><path d="M812 413L900 505" fill="none" stroke="#d1ab72" stroke-width="19" stroke-linecap="round"/></g>
  </svg><div class="sub">看得见的需求，比年份标签更接近真实机会。</div>
</section>
<section class="scene" id="s15" data-layout-ignore>
  <div class="eyebrow">15 / 把计划落地</div>
  <div class="title">再问自己，<br><span class="cyan">能转向哪里。</span></div>
  <svg viewBox="0 0 1080 1020" aria-label="技能、备用现金和备选路径三张纸卡铺成个人行动地图">
    <rect x="92" y="96" width="896" height="770" fill="#d8d0bd" stroke="#b89a6d" stroke-width="9"/><path d="M133 180H947M133 764H947" stroke="#aaa08d" stroke-width="5"/><text x="148" y="155" fill="#4b514a" font-family="Hive" font-size="43">我的行动地图</text>
    <g id="s15-card-a"><rect x="154" y="255" width="250" height="340" fill="#eee7d9" stroke="#d1ab72" stroke-width="8"/><text x="192" y="345" fill="#403b32" font-family="Hive" font-size="49" font-weight="700">技能</text><path d="M185 400H365M185 455H325M185 510H350" stroke="#a8a190" stroke-width="8" stroke-linecap="round"/></g>
    <g id="s15-card-b"><rect x="418" y="255" width="250" height="340" fill="#eee7d9" stroke="#9bbab6" stroke-width="8"/><text x="453" y="345" fill="#403b32" font-family="Hive" font-size="49" font-weight="700">缓冲</text><rect x="455" y="412" width="174" height="48" fill="#c9d6c9"/><rect x="455" y="478" width="130" height="48" fill="#c9d6c9"/></g>
    <g id="s15-card-c"><rect x="682" y="255" width="250" height="340" fill="#eee7d9" stroke="#c97565" stroke-width="8"/><text x="717" y="345" fill="#403b32" font-family="Hive" font-size="49" font-weight="700">备选</text><path d="M728 415H855M728 415L815 510M728 415L766 510" stroke="#c97565" stroke-width="9" fill="none" stroke-linecap="round"/></g>
    <path id="s15-route" d="M225 690C325 605 480 710 548 680S810 602 875 698" fill="none" stroke="#62867f" stroke-width="15" stroke-linecap="round"/><circle cx="225" cy="690" r="18" fill="#d1ab72"/><circle cx="875" cy="698" r="18" fill="#9bbab6"/>
  </svg><div class="sub">知道自己能做什么，也知道还能撑多久。</div>
</section>
<section class="scene" id="s16" data-layout-ignore>
  <div class="eyebrow">16 / 一张判断图</div>
  <div class="title">周期影响机会，<br><span class="gold">不替人做选择。</span></div>
  <svg viewBox="0 0 1080 1020" aria-label="经济波动经过行业需求和个人处境，最后才形成行动路径">
    <g id="s16-card-a"><rect x="170" y="100" width="740" height="150" fill="#e3d9c6" stroke="#d1ab72" stroke-width="9"/><text x="405" y="196" fill="#34342f" font-family="Hive" font-size="59" font-weight="700">经济波动</text><path d="M225 205C275 130 320 245 370 175" fill="none" stroke="#b99762" stroke-width="9"/></g>
    <g id="s16-card-b"><rect x="170" y="315" width="740" height="150" fill="#e3d9c6" stroke="#c6a772" stroke-width="9"/><text x="405" y="411" fill="#34342f" font-family="Hive" font-size="59" font-weight="700">行业需求</text><path d="M220 390H365" stroke="#b99762" stroke-width="10"/></g>
    <g id="s16-card-c"><rect x="170" y="530" width="740" height="150" fill="#e3d9c6" stroke="#9bbab6" stroke-width="9"/><text x="405" y="626" fill="#34342f" font-family="Hive" font-size="59" font-weight="700">个人处境</text><circle cx="288" cy="605" r="28" fill="none" stroke="#789f98" stroke-width="9"/><path d="M240 650C250 615 325 615 338 650" fill="none" stroke="#789f98" stroke-width="9"/></g>
    <g id="s16-card-d"><rect x="170" y="745" width="740" height="150" fill="#e3d9c6" stroke="#c97565" stroke-width="9"/><text x="405" y="842" fill="#34342f" font-family="Hive" font-size="59" font-weight="700">行动路径</text><path d="M225 810H300L330 790M300 810L330 840" fill="none" stroke="#c97565" stroke-width="9"/></g>
    <g id="s16-links" fill="#d1ab72"><path d="M520 263L540 299L560 263Z"/><path d="M520 478L540 514L560 478Z"/><path d="M520 693L540 729L560 693Z"/></g>
  </svg><div class="sub">一层层追问，才知道自己下一步能怎么走。</div>
</section>
<section class="scene" id="s17" data-layout-ignore>
  <div class="eyebrow">17 / 回到开头</div>
  <div class="title">世界有波动。<br><span class="gold">人生，没有命运表。</span></div>
  <svg viewBox="0 0 1080 1920" aria-label="同一年的两封回信落在同一条时间线上，各自延伸出不同道路">
    <path id="s17-wave" d="M-60 1250C150 1050 265 1400 470 1245S805 1050 1140 1265" fill="none" stroke="#8d7756" stroke-width="18" stroke-linecap="round" opacity=".7"/>
    <g id="s17-year"><rect x="392" y="1120" width="296" height="105" fill="#e6dac4" stroke="#d1ab72" stroke-width="8"/><text x="444" y="1192" fill="#34342f" font-family="Hive" font-size="53" font-weight="700">同一年</text></g>
    <g id="s17-paths"><path id="s17-path-a" d="M537 1228C390 1325 280 1340 180 1350" fill="none" stroke="#9bbab6" stroke-width="14" stroke-linecap="round"/><path id="s17-path-b" d="M543 1228C660 1290 760 1400 900 1350" fill="none" stroke="#c97565" stroke-width="14" stroke-linecap="round"/><rect x="108" y="1350" width="236" height="118" fill="#e7ddca" stroke="#9bbab6" stroke-width="8"/><text x="155" y="1429" fill="#3e6d68" font-family="Hive" font-size="48" font-weight="700">录用</text><rect x="752" y="1350" width="236" height="118" fill="#e7ddca" stroke="#c97565" stroke-width="8"/><text x="799" y="1429" fill="#8f4b43" font-family="Hive" font-size="48" font-weight="700">缩招</text></g>
  </svg><div class="sub">经济有长短起伏，个人的结果不能由出生年份写定。</div>
</section>
<div id="transition-flash" class="wipe" data-layout-ignore></div><div id="transition-bar" class="hitbar" data-layout-ignore></div><div id="fracture" class="fracture" data-layout-ignore></div>
</div>
